#!/bin/bash
set -euo pipefail

usage() {
  echo "Usage: $0 (--check | --apply) --from /path/to/Enmanner [--target /path/to/.enmanner] [--upstream-url URL] [--json]" >&2
}

mode=""
source_argument=""
target_argument=""
json=false
explicit_upstream_url=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --check|--apply) mode="$1" ;;
    --from)
      shift
      source_argument="${1:-}"
      ;;
    --target)
      shift
      target_argument="${1:-}"
      ;;
    --upstream-url)
      shift
      explicit_upstream_url="${1:-}"
      [[ -n "$explicit_upstream_url" ]] || { usage; exit 64; }
      ;;
    --json) json=true ;;
    *) usage; exit 64 ;;
  esac
  shift
done
[[ -n "$mode" && -n "$source_argument" ]] || { usage; exit 64; }

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "$target_argument" ]]; then
  installation_root="$(cd "$target_argument" && pwd)"
else
  installation_root="$(cd "$script_dir/.." && pwd)"
fi
if [[ -f "$source_argument/integration/VERSION" ]]; then
  source_root="$(cd "$source_argument/integration" && pwd)"
else
  source_root="$(cd "$source_argument" && pwd)"
fi
[[ -f "$source_root/VERSION" ]] || {
  echo "Error: $source_root is not an Enmanner distribution source." >&2
  exit 1
}

provenance="$installation_root/INSTALLATION.json"
[[ -f "$provenance" ]] || {
  echo "Error: INSTALLATION.json is missing; reinstall this pre-0.3 integration from scratch." >&2
  exit 1
}

conflicts=()
conflict_count=0
tracked_paths="$(mktemp "${TMPDIR:-/tmp}/enmanner-tracked.XXXXXX")"
trap 'rm -f "$tracked_paths"' EXIT

index=0
while path="$(
  /usr/bin/plutil -extract "files.$index.path" raw "$provenance" 2>/dev/null
)"; do
  printf '%s\n' "$path" >> "$tracked_paths"
  expected="$(
    /usr/bin/plutil -extract "files.$index.sha256" raw "$provenance"
  )"
  destination_file="$installation_root/$path"
  if [[ -f "$destination_file" ]]; then
    actual="$(
      /usr/bin/shasum -a 256 "$destination_file" |
        /usr/bin/awk '{print $1}'
    )"
    if [[ "$actual" != "$expected" ]]; then
      conflicts+=("$path")
      conflict_count=$((conflict_count + 1))
    fi
  fi
  index=$((index + 1))
done

while IFS= read -r -d '' installed_file; do
  relative="${installed_file#"$installation_root"/}"
  [[ "$relative" == "INSTALLATION.json" ]] && continue
  [[ "$relative" == framework/.build/* ]] && continue
  if ! grep -Fqx "$relative" "$tracked_paths"; then
    conflicts+=("$relative (untracked framework file)")
    conflict_count=$((conflict_count + 1))
  fi
done < <(find "$installation_root" -type f \
  -not -path '*/.build/*' -print0)

from_version="$(/usr/bin/plutil -extract version raw "$provenance")"
to_version="$(tr -d '[:space:]' < "$source_root/VERSION")"
project_manifest="$(dirname "$installation_root")/enmanner/enmanner.json"
backup_recommended=false
if [[ -f "$project_manifest" ]] &&
  /usr/bin/plutil -extract backup.command json -o /dev/null \
    "$project_manifest" >/dev/null 2>&1; then
  backup_recommended=true
fi

emit_json() {
  printf '{"mode":"%s","fromVersion":"%s","toVersion":"%s","conflicts":[' \
    "${mode#--}" "$from_version" "$to_version"
  separator=""
  if [[ $conflict_count -gt 0 ]]; then
    for conflict in "${conflicts[@]}"; do
      escaped="${conflict//\\/\\\\}"
      escaped="${escaped//\"/\\\"}"
      printf '%s"%s"' "$separator" "$escaped"
      separator=","
    done
  fi
  printf '],"backupRecommendedBeforeApply":%s,"applicable":%s,"applied":%s}\n' \
    "$backup_recommended" \
    "$([[ $conflict_count -eq 0 ]] && echo true || echo false)" \
    "$1"
}

if [[ "$json" != true ]]; then
  echo "Enmanner upgrade: $from_version → $to_version"
  if [[ $conflict_count -gt 0 ]]; then
    echo "Conflicting locally modified framework files:"
    printf '  %s\n' "${conflicts[@]}"
  else
    echo "✓ No locally modified framework files conflict."
  fi
  if [[ "$backup_recommended" == true ]]; then
    echo "! This project declares File → Back Up Now; run it before applying framework changes when current data is not already protected."
  fi
fi

if [[ "$mode" == "--check" ]]; then
  [[ "$json" == true ]] && emit_json false
  exit 0
fi
if [[ $conflict_count -gt 0 ]]; then
  [[ "$json" == true ]] && emit_json false
  echo "Error: upgrade was not applied. Reinstall or resolve the listed files first." >&2
  exit 2
fi

/usr/bin/rsync -a --delete \
  --exclude ".build" \
  --exclude ".DS_Store" \
  --exclude "INSTALLATION.json" \
  --exclude "framework/Tests/" \
  --exclude "scripts/install" \
  "$source_root/" "$installation_root/"

record_args=(--source "$source_root")
[[ -n "$explicit_upstream_url" ]] &&
  record_args+=(--upstream-url "$explicit_upstream_url")
if [[ "$json" == true ]]; then
  "$installation_root/scripts/record-installation" "${record_args[@]}" >/dev/null
  "$installation_root/scripts/validate" --json >/dev/null
  emit_json true
else
  "$installation_root/scripts/record-installation" "${record_args[@]}"
  "$installation_root/scripts/validate"
  if [[ "$from_version" == "$to_version" ]]; then
    echo "✓ Refreshed installation provenance and statically validated Enmanner $to_version"
  else
    echo "✓ Upgraded and statically validated Enmanner $to_version"
  fi
fi
