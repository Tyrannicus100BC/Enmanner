#!/bin/bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: install [options] /path/to/project

Options:
  --plan                 Inspect and report without changing the project
  --no-build             Install files but do not build the app
  --runtime              Opt in to state-changing runtime validation
  --json                 Emit one machine-readable result
  --repair               Repair or update an existing installation
  --name NAME            Set the generated application name
  --identifier ID        Set the generated bundle identifier
  --allow-legacy-icon    Permit an intentional legacy icon fallback
  --replace-existing-app Replace an app only after explicit collision review
EOF
}

json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  printf '%s' "$value"
}

plan=false
skip_build=false
runtime_validation=false
json=false
repair=false
allow_legacy_icon=false
replace_existing_app=false
requested_name=""
requested_identifier=""
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --plan) plan=true ;;
    --no-build) skip_build=true ;;
    --runtime) runtime_validation=true ;;
    --json) json=true ;;
    --repair) repair=true ;;
    --allow-legacy-icon) allow_legacy_icon=true ;;
    --replace-existing-app) replace_existing_app=true ;;
    --name)
      shift
      requested_name="${1:-}"
      [[ -n "$requested_name" ]] || { usage; exit 64; }
      ;;
    --identifier)
      shift
      requested_identifier="${1:-}"
      [[ -n "$requested_identifier" ]] || { usage; exit 64; }
      ;;
    --help|-h) usage; exit 0 ;;
    *) usage; exit 64 ;;
  esac
  shift
done
[[ $# -eq 1 ]] || { usage; exit 64; }
if [[ "$skip_build" == true && "$runtime_validation" == true ]]; then
  echo "Error: --no-build and --runtime cannot be used together." >&2
  exit 64
fi
if [[ "$repair" == true && ( -n "$requested_name" || -n "$requested_identifier" ) ]]; then
  echo "Error: --name and --identifier do not apply to --repair." >&2
  exit 64
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source_dir="$(cd "$script_dir/.." && pwd)"
target_dir="$(cd "$1" && pwd)"
destination="$target_dir/.enmanner"
configuration_dir="$target_dir/enmanner"
manifest_path="$configuration_dir/enmanner.json"
manifest_relative_path="enmanner/enmanner.json"
draft_manifest_path="$configuration_dir/enmanner.json.example"

[[ -w "$target_dir" || "$plan" == true ]] || {
  echo "Error: The project directory is not writable: $target_dir" >&2
  exit 1
}

while IFS= read -r -d '' root_manifest; do
  echo "Error: the manifest must live at enmanner/enmanner.json." >&2
  echo "  Remove the root-level $(basename "$root_manifest") before installing." >&2
  exit 1
done < <(find "$target_dir" -mindepth 1 -maxdepth 1 -type f \
  -iname 'enmanner.json' -print0)

git_classification="unversioned"
git_root=""
nested_repositories=0
while IFS= read -r -d '' ignored_git_marker; do
  nested_repositories=$((nested_repositories + 1))
done < <(find "$target_dir" -mindepth 2 -maxdepth 5 \
  \( -type d -o -type f \) -name .git \
  -not -path '*/node_modules/*' -print0 2>/dev/null)

if command -v git >/dev/null 2>&1 &&
  git_root="$(git -C "$target_dir" rev-parse --show-toplevel 2>/dev/null)"; then
  if [[ "$git_root" == "$target_dir" ]]; then
    git_classification="repository-root"
  elif [[ $nested_repositories -gt 0 ]]; then
    git_classification="workspace-with-nested-repositories"
  else
    git_classification="subdirectory-of-repository"
  fi
elif [[ $nested_repositories -gt 0 ]]; then
  git_classification="workspace-with-nested-repositories"
fi

git_branch=""
git_dirty=false
git_has_upstream=false
git_ahead=0
git_behind=0
if [[ -n "$git_root" ]]; then
  git_branch="$(git -C "$target_dir" symbolic-ref --short HEAD 2>/dev/null || true)"
  [[ -n "$(git -C "$target_dir" status --porcelain -- . 2>/dev/null)" ]] &&
    git_dirty=true
  ahead_behind="$(
    git -C "$target_dir" rev-list --left-right --count \
      '@{upstream}...HEAD' 2>/dev/null || true
  )"
  if [[ -n "$ahead_behind" ]]; then
    git_has_upstream=true
    git_behind="$(printf '%s' "$ahead_behind" | /usr/bin/awk '{print $1}')"
    git_ahead="$(printf '%s' "$ahead_behind" | /usr/bin/awk '{print $2}')"
  fi
fi

project_name="${requested_name:-$(basename "$target_dir")}"
if [[ -f "$manifest_path" ]]; then
  existing_name="$(/usr/bin/plutil -extract name raw "$manifest_path" 2>/dev/null || true)"
  [[ -z "$requested_name" && -n "$existing_name" ]] && project_name="$existing_name"
fi
slug="$(printf '%s' "$project_name" |
  tr '[:upper:]' '[:lower:]' |
  sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
[[ -n "$slug" ]] || slug="app"
bundle_identifier="${requested_identifier:-local.enmanner.$slug}"
if [[ -f "$manifest_path" && -z "$requested_identifier" ]]; then
  existing_identifier="$(
    /usr/bin/plutil -extract identifier raw "$manifest_path" 2>/dev/null || true
  )"
  [[ -n "$existing_identifier" ]] && bundle_identifier="$existing_identifier"
fi
identifier_checksum="$(printf '%s' "$bundle_identifier" | /usr/bin/cksum | /usr/bin/awk '{print $1}')"
preferred_port=$((42000 + identifier_checksum % 6000))

package_manager=""
package_manager_signal=""
candidate_command=""
candidate_working_directory="."
candidate_inspect_path=""
detected_framework=""
manifest_status="configurationRequired"
inference_reason="No supported high-confidence startup command was found."
detected_stacks=()
detected_stack_count=0

add_detected_stack() {
  local stack="$1"
  local existing
  if [[ $detected_stack_count -gt 0 ]]; then
    for existing in "${detected_stacks[@]}"; do
      [[ "$existing" == "$stack" ]] && return
    done
  fi
  detected_stacks+=("$stack")
  detected_stack_count=$((detected_stack_count + 1))
}

if [[ -f "$target_dir/package.json" ]]; then
  add_detected_stack "Node.js"
  candidate_inspect_path="package.json"

  declared_package_manager="$(
    /usr/bin/plutil -extract packageManager raw \
      "$target_dir/package.json" 2>/dev/null || true
  )"
  declared_package_manager_name=""
  if [[ -n "$declared_package_manager" ]]; then
    if [[ "$declared_package_manager" =~ ^(npm|pnpm|yarn|bun)@.+$ ]]; then
      declared_package_manager_name="${BASH_REMATCH[1]}"
    else
      inference_reason="The root packageManager field is unsupported or malformed: $declared_package_manager"
    fi
  fi

  lockfile_managers=()
  [[ -f "$target_dir/package-lock.json" ||
    -f "$target_dir/npm-shrinkwrap.json" ]] &&
    lockfile_managers+=("npm")
  [[ -f "$target_dir/pnpm-lock.yaml" ]] &&
    lockfile_managers+=("pnpm")
  [[ -f "$target_dir/yarn.lock" ]] &&
    lockfile_managers+=("yarn")
  [[ -f "$target_dir/bun.lock" || -f "$target_dir/bun.lockb" ]] &&
    lockfile_managers+=("bun")

  package_manager_conflict=false
  if [[ ${#lockfile_managers[@]} -gt 1 ]]; then
    package_manager_conflict=true
    inference_reason="Conflicting root lockfiles were found for: ${lockfile_managers[*]}. Remove stale lockfiles or declare one verified package manager."
  elif [[ -n "$declared_package_manager" &&
    -z "$declared_package_manager_name" ]]; then
    package_manager_conflict=true
  elif [[ -n "$declared_package_manager_name" &&
    ${#lockfile_managers[@]} -eq 1 &&
    "${lockfile_managers[0]}" != "$declared_package_manager_name" ]]; then
    package_manager_conflict=true
    inference_reason="The packageManager field selects $declared_package_manager_name, but the root lockfile selects ${lockfile_managers[0]}. Resolve the conflicting package-manager signals."
  fi

  if [[ "$package_manager_conflict" != true ]]; then
    if [[ -n "$declared_package_manager_name" ]]; then
      package_manager="$declared_package_manager_name"
      package_manager_signal="packageManager"
    elif [[ ${#lockfile_managers[@]} -eq 1 ]]; then
      package_manager="${lockfile_managers[0]}"
      package_manager_signal="lockfile"
    else
      package_manager="npm"
      package_manager_signal="default"
    fi
  fi

  selected_script=""
  selected_script_value=""
  for script_name in dev start serve; do
    selected_script_value="$(
      /usr/bin/plutil -extract "scripts.$script_name" raw \
        "$target_dir/package.json" 2>/dev/null || true
    )"
    if [[ -n "$selected_script_value" ]]; then
      selected_script="$script_name"
      break
    fi
  done
  if [[ -n "$selected_script" &&
    "$package_manager_conflict" != true &&
    -n "$package_manager" ]]; then
    if [[ "$package_manager" == "npm" ]]; then
      candidate_command="[\"npm\", \"run\", \"$selected_script\"]"
    else
      candidate_command="[\"$package_manager\", \"run\", \"$selected_script\"]"
    fi
    inference_reason="Found the root $package_manager script '$selected_script'; host and dynamic-port behavior remain unverified."
    if [[ "$selected_script_value" =~ ^node[[:space:]]+([^[:space:]]+) ]]; then
      possible_entry="${BASH_REMATCH[1]}"
      possible_entry="${possible_entry#./}"
      if [[ "$possible_entry" != /* &&
        -f "$target_dir/$possible_entry" ]]; then
        candidate_inspect_path="$possible_entry"
      fi
    fi
  fi

  has_vite_dependency=false
  has_next_dependency=false
  for dependency_section in dependencies devDependencies; do
    if /usr/bin/plutil -extract "$dependency_section.vite" raw \
      "$target_dir/package.json" >/dev/null 2>&1; then
      has_vite_dependency=true
    fi
    if /usr/bin/plutil -extract "$dependency_section.next" raw \
      "$target_dir/package.json" >/dev/null 2>&1; then
      has_next_dependency=true
    fi
  done

  framework_conflict=false
  if [[ "$has_vite_dependency" == true && "$has_next_dependency" == true ]]; then
    framework_conflict=true
    inference_reason="Both Vite and Next.js are direct root dependencies; choose and verify the launcher command explicitly."
  elif [[ "$has_vite_dependency" == true ]]; then
    detected_framework="vite"
    add_detected_stack "Vite"
  elif [[ "$has_next_dependency" == true ]]; then
    detected_framework="next"
    add_detected_stack "Next.js"
  fi

  script_matches_adapter=false
  if [[ "$detected_framework" == "vite" &&
    "$selected_script" == "dev" &&
    "$selected_script_value" =~ ^vite([[:space:]]+(dev|serve))?[[:space:]]*$ ]]; then
    script_matches_adapter=true
  elif [[ "$detected_framework" == "next" &&
    "$selected_script" == "dev" &&
    "$selected_script_value" =~ ^next[[:space:]]+dev([[:space:]]+(--turbopack|--turbo|--webpack))?[[:space:]]*$ ]]; then
    script_matches_adapter=true
  fi

  if [[ "$package_manager_conflict" != true &&
    "$framework_conflict" != true &&
    "$script_matches_adapter" == true ]]; then
    case "$package_manager:$detected_framework" in
      npm:vite)
        candidate_command='["npm", "run", "dev", "--", "--host", "127.0.0.1", "--port", "${ENMANNER_PORT}", "--strictPort"]'
        ;;
      pnpm:vite)
        candidate_command='["pnpm", "run", "dev", "--host", "127.0.0.1", "--port", "${ENMANNER_PORT}", "--strictPort"]'
        ;;
      yarn:vite)
        candidate_command='["yarn", "run", "dev", "--host", "127.0.0.1", "--port", "${ENMANNER_PORT}", "--strictPort"]'
        ;;
      bun:vite)
        candidate_command='["bun", "run", "dev", "--host", "127.0.0.1", "--port", "${ENMANNER_PORT}", "--strictPort"]'
        ;;
      npm:next)
        candidate_command='["npm", "run", "dev", "--", "--hostname", "127.0.0.1", "--port", "${ENMANNER_PORT}"]'
        ;;
      pnpm:next)
        candidate_command='["pnpm", "run", "dev", "--hostname", "127.0.0.1", "--port", "${ENMANNER_PORT}"]'
        ;;
      yarn:next)
        candidate_command='["yarn", "run", "dev", "--hostname", "127.0.0.1", "--port", "${ENMANNER_PORT}"]'
        ;;
      bun:next)
        candidate_command='["bun", "run", "dev", "--hostname", "127.0.0.1", "--port", "${ENMANNER_PORT}"]'
        ;;
    esac
    if [[ -n "$candidate_command" ]]; then
      manifest_status="inferred"
      inference_reason="Verified a root $package_manager $detected_framework development script with explicit loopback and dynamic-port arguments."
    fi
  elif [[ "$package_manager_conflict" != true &&
    "$framework_conflict" != true &&
    -n "$detected_framework" &&
    "$selected_script" == "dev" ]]; then
    inference_reason="Detected $detected_framework with package manager $package_manager, but the root dev script is not a tested direct framework command."
  fi
else
  nested_package=""
  while IFS= read -r candidate_package; do
    if [[ -n "$nested_package" ]]; then
      nested_package="multiple"
      break
    fi
    nested_package="$candidate_package"
  done < <(find "$target_dir" -mindepth 2 -maxdepth 4 -name package.json \
    -not -path '*/node_modules/*' -print 2>/dev/null | sort)
  [[ -n "$nested_package" ]] && add_detected_stack "Node.js"
  if [[ -n "$nested_package" && "$nested_package" != "multiple" ]]; then
    relative_package="${nested_package#"$target_dir"/}"
    candidate_working_directory="$(dirname "$relative_package")"
    candidate_inspect_path="$relative_package"
    inference_reason="Found one nested package.json at ${nested_package#"$target_dir"/}; startup and port behavior require review."
  elif [[ "$nested_package" == "multiple" ]]; then
    inference_reason="Found multiple nested packages; choose a project-owned foreground supervisor."
  fi
fi

compose_path="$(find "$target_dir" -maxdepth 4 -not -path '*/node_modules/*' \
  \( -name 'compose.yml' -o -name 'compose.yaml' \
  -o -name 'docker-compose.yml' -o -name 'docker-compose.yaml' \) \
  -print -quit 2>/dev/null)"
if [[ -n "$compose_path" ]]; then
  add_detected_stack "Docker Compose"
  [[ -n "$candidate_inspect_path" ]] ||
    candidate_inspect_path="${compose_path#"$target_dir"/}"
fi
makefile_path="$(
  find "$target_dir" -maxdepth 4 -not -path '*/node_modules/*' \
    -name Makefile -print -quit 2>/dev/null
)"
if [[ -n "$makefile_path" ]]; then
  add_detected_stack "Make"
  [[ -n "$candidate_inspect_path" ]] ||
    candidate_inspect_path="${makefile_path#"$target_dir"/}"
fi
go_mod_path="$(find "$target_dir" -maxdepth 4 -name go.mod -print -quit 2>/dev/null)"
if [[ -n "$go_mod_path" ]]; then
  add_detected_stack "Go"
  [[ -n "$candidate_inspect_path" ]] ||
    candidate_inspect_path="${go_mod_path#"$target_dir"/}"
fi
cargo_path="$(find "$target_dir" -maxdepth 4 -name Cargo.toml -print -quit 2>/dev/null)"
if [[ -n "$cargo_path" ]]; then
  add_detected_stack "Cargo"
  [[ -n "$candidate_inspect_path" ]] ||
    candidate_inspect_path="${cargo_path#"$target_dir"/}"
fi
python_path="$(find "$target_dir" -maxdepth 4 \
  \( -name pyproject.toml -o -name requirements.txt \) \
  -print -quit 2>/dev/null)"
if [[ -n "$python_path" ]]; then
  add_detected_stack "Python"
  [[ -n "$candidate_inspect_path" ]] ||
    candidate_inspect_path="${python_path#"$target_dir"/}"
fi

if [[ -f "$manifest_path" ]]; then
  manifest_status="existing"
  inference_reason="An existing project-owned $manifest_relative_path will be preserved."
elif [[ "$manifest_status" == "configurationRequired" &&
  "$inference_reason" == "No supported high-confidence startup command was found." &&
  $detected_stack_count -gt 0 ]]; then
  inference_reason="Detected ${detected_stacks[*]}, but no tested high-confidence adapter matched. Hand-author the manifest using the reported evidence and compatibility checks."
fi

escaped_app_name="$project_name"
escaped_app_name="${escaped_app_name//\\/\\\\}"
escaped_app_name="${escaped_app_name//\[/\\[}"
escaped_app_name="${escaped_app_name//\]/\\]}"
escaped_app_name="${escaped_app_name//\*/\\*}"
escaped_app_name="${escaped_app_name//\?/\\?}"
escaped_app_name="${escaped_app_name//#/\\#}"
escaped_app_name="${escaped_app_name//!/\\!}"
app_ignore="/$escaped_app_name.app/"
icon_configured=false
if [[ -f "$manifest_path" ]]; then
  existing_icon="$(/usr/bin/plutil -extract icon raw "$manifest_path" 2>/dev/null || true)"
  [[ -n "$existing_icon" ]] && icon_configured=true
fi

gitignore_needs_update=true
grep -q "# enmanner:begin" "$target_dir/.gitignore" 2>/dev/null &&
  gitignore_needs_update=false
agents_needs_update=true
grep -q "<!-- enmanner:begin -->" "$target_dir/AGENTS.md" 2>/dev/null &&
  agents_needs_update=false
other_agent_files=()
other_agent_file_count=0
for agent_file in CLAUDE.md GEMINI.md .github/copilot-instructions.md; do
  if [[ -f "$target_dir/$agent_file" ]]; then
    other_agent_files+=("$agent_file")
    other_agent_file_count=$((other_agent_file_count + 1))
  fi
done
if [[ -d "$target_dir/.cursor/rules" ]]; then
  other_agent_files+=(".cursor/rules/")
  other_agent_file_count=$((other_agent_file_count + 1))
fi
stale_draft=false
[[ -f "$manifest_path" && -f "$draft_manifest_path" ]] &&
  stale_draft=true
manifest_will_write=false
[[ ! -e "$manifest_path" && "$manifest_status" == "inferred" ]] &&
  manifest_will_write=true
draft_will_write=false
[[ ! -e "$manifest_path" &&
  "$manifest_status" == "configurationRequired" &&
  ! -e "$draft_manifest_path" ]] &&
  draft_will_write=true

will_build=true
if [[ "$plan" == true || "$skip_build" == true ||
  "$manifest_status" == "configurationRequired" ||
  "$icon_configured" != true ]]; then
  will_build=false
fi

emit_result() {
  local installed="$1"
  local built="$2"
  local action="$3"
  local completion_status="installed"
  if [[ "$built" == true ]]; then
    completion_status="complete"
  elif [[ "$manifest_status" == "configurationRequired" ]]; then
    completion_status="configurationRequired"
  elif [[ "$icon_configured" != true ]]; then
    completion_status="iconRequired"
  fi
  if [[ "$json" == true ]]; then
    printf '{'
    printf '"schemaVersion":1,'
    printf '"action":"%s",' "$(json_escape "$action")"
    printf '"target":"%s",' "$(json_escape "$target_dir")"
    printf '"installed":%s,' "$installed"
    printf '"completionStatus":"%s",' "$completion_status"
    printf '"manifestStatus":"%s",' "$(json_escape "$manifest_status")"
    printf '"configurationRequired":%s,' \
      "$([[ "$manifest_status" == "configurationRequired" ]] && echo true || echo false)"
    printf '"built":%s,' "$built"
    printf '"build":{"planned":%s,"iconConfigured":%s,' \
      "$will_build" "$icon_configured"
    if [[ "$manifest_status" == "configurationRequired" ]]; then
      printf '"blockedBy":"configurationRequired"},'
    elif [[ "$icon_configured" != true ]]; then
      printf '"blockedBy":"iconRequired"},'
    elif [[ "$plan" == true ]]; then
      printf '"blockedBy":"planOnly"},'
    elif [[ "$skip_build" == true ]]; then
      printf '"blockedBy":"noBuildRequested"},'
    else
      printf '"blockedBy":null},'
    fi
    printf '"git":{"classification":"%s","root":"%s","nestedRepositories":%d,"branch":"%s","dirty":%s,"hasUpstream":%s,"ahead":%d,"behind":%d,"aheadBehindSource":"localRemoteTrackingRefs","networkAccessed":false},' \
      "$(json_escape "$git_classification")" "$(json_escape "$git_root")" \
      "$nested_repositories" "$(json_escape "$git_branch")" "$git_dirty" \
      "$git_has_upstream" "$git_ahead" "$git_behind"
    printf '"detectedStacks":['
    detected_separator=""
    if [[ $detected_stack_count -gt 0 ]]; then
      for detected_stack in "${detected_stacks[@]}"; do
        printf '%s"%s"' "$detected_separator" "$(json_escape "$detected_stack")"
        detected_separator=","
      done
    fi
    printf '],'
    printf '"inference":{"packageManager":"%s","packageManagerSignal":"%s","framework":"%s","workingDirectory":"%s","command":%s,"preferredPort":%d,"reason":"%s","signalsExamined":["root package.json packageManager field","root npm, pnpm, Yarn, and Bun lockfiles","root package.json scripts dev/start/serve","root Vite or Next.js dependency","nested package.json files","Docker Compose files","Makefile","go.mod","Cargo.toml","pyproject.toml or requirements.txt"],"inspect":[' \
      "$(json_escape "$package_manager")" \
      "$(json_escape "$package_manager_signal")" \
      "$(json_escape "$detected_framework")" \
      "$(json_escape "$candidate_working_directory")" \
      "${candidate_command:-null}" "$preferred_port" \
      "$(json_escape "$inference_reason")"
    if [[ -n "$candidate_inspect_path" ]]; then
      printf '"%s"' "$(json_escape "$candidate_inspect_path")"
    fi
    printf ']},'
    printf '"otherAgentInstructions":['
    other_agent_separator=""
    if [[ $other_agent_file_count -gt 0 ]]; then
      for agent_file in "${other_agent_files[@]}"; do
        printf '%s"%s"' "$other_agent_separator" "$(json_escape "$agent_file")"
        other_agent_separator=","
      done
    fi
    printf '],'
    printf '"fileOperations":['
    printf '{"action":"createDirectory","path":".enmanner/","willWrite":true},'
    printf '{"action":"createDirectory","path":"enmanner/","willWrite":true},'
    printf '{"action":"ensureManagedSection","path":"AGENTS.md","willWrite":%s},' \
      "$agents_needs_update"
    printf '{"action":"ensureManagedSection","path":".gitignore","willWrite":%s},' \
      "$gitignore_needs_update"
    if [[ "$manifest_status" == "inferred" ]]; then
      printf '{"action":"create","path":"enmanner/enmanner.json","willWrite":%s}' \
        "$manifest_will_write"
    elif [[ "$manifest_status" == "configurationRequired" ]]; then
      printf '{"action":"create","path":"enmanner/enmanner.json.example","willWrite":%s}' \
        "$draft_will_write"
    else
      printf '{"action":"preserve","path":"%s","willWrite":false}' \
        "$manifest_relative_path"
    fi
    printf '],'
    printf '"performedWrites":['
    if [[ "$installed" == true ]]; then
      printf '".enmanner/","enmanner/"'
      [[ "$agents_needs_update" == true ]] &&
        printf ',"AGENTS.md managed section"'
      [[ "$gitignore_needs_update" == true ]] &&
        printf ',".gitignore managed section"'
      if [[ "$manifest_will_write" == true ]]; then
        printf ',"enmanner/enmanner.json"'
      elif [[ "$draft_will_write" == true ]]; then
        printf ',"enmanner/enmanner.json.example"'
      fi
    fi
    printf '],'
    printf '"unresolvedChecks":['
    if [[ "$manifest_status" == "configurationRequired" ]]; then
      inspect_json="[]"
      if [[ -n "$candidate_inspect_path" ]]; then
        inspect_json="[\"$(json_escape "$candidate_inspect_path")\"]"
      fi
      printf '{"id":"dynamicPort","status":"unknown","requirement":"server honors ENMANNER_PORT","evidence":"startup candidate found but dynamic-port behavior is unverified","inspect":%s,"suggestedChange":"prefer ENMANNER_PORT over framework-specific port variables"},' "$inspect_json"
      printf '{"id":"loopbackBinding","status":"unknown","requirement":"server binds only to loopback","evidence":"startup candidate does not prove its listener host","inspect":%s,"suggestedChange":"bind the public listener explicitly to 127.0.0.1"},' "$inspect_json"
      printf '{"id":"foregroundLifecycle","status":"unknown","requirement":"command remains in the foreground","evidence":"child and daemon behavior requires project review","inspect":%s,"suggestedChange":"use one foreground command or a project-owned supervisor"}' "$inspect_json"
    fi
    printf '],'
    printf '"nextActions":['
    if [[ "$manifest_status" == "configurationRequired" ]]; then
      printf '"reviewDraftManifest","resolveCompatibilityChecks",'
    fi
    if [[ "$manifest_status" != "configurationRequired" ]]; then
      printf '"validateLifecycle",'
    fi
    if [[ "$icon_configured" != true ]]; then
      printf '"createAndConfigureIcon",'
    fi
    printf '"buildApp"],'
    printf '"nextActionCommands":['
    if [[ "$manifest_status" != "configurationRequired" ]]; then
      printf '{"id":"validateLifecycle","command":["./.enmanner/scripts/validate","--runtime","--json"]},'
    fi
    printf '{"id":"inspectIntegrationState","command":["./.enmanner/scripts/doctor","--json"]},'
    printf '{"id":"buildApp","command":["./.enmanner/scripts/build-app","--json"]}],'
    printf '"warnings":['
    warning_separator=""
    if [[ "$stale_draft" == true ]]; then
      printf '"%s.example remains beside the live manifest; remove the stale draft after confirming it is no longer needed"' \
        "$(json_escape "$manifest_relative_path")"
      warning_separator=","
    fi
    if [[ $other_agent_file_count -gt 0 ]]; then
      printf '%s"Other agent instruction files were detected; mirror the managed AGENTS.md guidance there when they are authoritative for this project"' "$warning_separator"
    fi
    printf ']'
    printf '}\n'
  else
    echo "Enmanner $action for: $target_dir"
    echo "  Git: $git_classification${git_root:+ ($git_root)}"
    echo "  Manifest: $manifest_status"
    if [[ $detected_stack_count -gt 0 ]]; then
      echo "  Detected stacks: ${detected_stacks[*]}"
    fi
    [[ -n "$candidate_command" ]] && echo "  Candidate command: $candidate_command"
    echo "  $inference_reason"
    echo "  Files: .enmanner/, enmanner/, managed AGENTS.md and .gitignore sections"
    if [[ "$manifest_status" == "configurationRequired" ]]; then
      echo "  Draft: enmanner/enmanner.json.example"
    fi
    echo "  Build: $([[ "$will_build" == true ]] && echo planned || echo not-planned)"
    if [[ "$icon_configured" != true &&
      "$manifest_status" != "configurationRequired" ]]; then
      echo "  Completion: icon required before the app can be built"
    fi
    [[ "$stale_draft" == true ]] &&
      echo "  Warning: remove stale $manifest_relative_path.example after confirming it is no longer needed"
    if [[ $other_agent_file_count -gt 0 ]]; then
      echo "  Agent instructions: also review ${other_agent_files[*]}"
      echo "  Mirror the managed AGENTS.md guidance when one of those files is authoritative."
    fi
  fi
}

if [[ "$plan" == true ]]; then
  if [[ "$repair" == true && ! -d "$destination" ]]; then
    echo "Error: no Enmanner installation exists at $destination." >&2
    exit 1
  fi
  if [[ "$repair" == true ]]; then
    repair_plan_args=(--check --from "$source_dir" --target "$destination")
    [[ "$json" == true ]] && repair_plan_args+=(--json)
    "$source_dir/scripts/upgrade" "${repair_plan_args[@]}"
    exit 0
  fi
  emit_result false false plan
  exit 0
fi

if [[ "$repair" == true ]]; then
  upgrade_args=(
    --apply --from "$source_dir" --target "$destination"
  )
  [[ "$json" == true ]] && upgrade_args+=(--json)
  "$source_dir/scripts/upgrade" "${upgrade_args[@]}"
  exit 0
fi

if [[ "$json" != true ]]; then
  echo "Installing Enmanner into: $target_dir"
  echo "  Will copy framework-owned files into .enmanner/."
  echo "  Will keep project-owned integration files in enmanner/."
  echo "  Will update only managed sections in AGENTS.md and .gitignore."
  if [[ "$manifest_status" == "configurationRequired" ]]; then
    echo "  Will write an inactive enmanner/enmanner.json.example; no app will be built."
  elif [[ "$icon_configured" != true ]]; then
    echo "  Will validate configuration; no app will be built until an icon is configured."
  else
    echo "  Will validate configuration and build the configured app."
  fi
fi

if [[ -e "$destination" ]]; then
  echo "Error: Enmanner is already present at $destination." >&2
  echo "Use --plan --repair to inspect or --repair to restore/update framework files." >&2
  exit 1
fi

mkdir -p "$destination" "$configuration_dir"
/usr/bin/rsync -a \
  --exclude ".build" \
  --exclude ".DS_Store" \
  --exclude "INSTALLATION.json" \
  --exclude "framework/Tests/" \
  --exclude "scripts/install" \
  "$source_dir/" "$destination/"

if [[ ! -e "$manifest_path" && "$manifest_status" == "inferred" ]]; then
  {
    echo '{'
    echo '  "$schema": "../.enmanner/enmanner.schema.json",'
    echo '  "version": 2,'
    printf '  "name": "%s",\n' "$(json_escape "$project_name")"
    printf '  "identifier": "%s",\n' "$(json_escape "$bundle_identifier")"
    echo '  "server": {'
    echo "    \"command\": $candidate_command,"
    echo '    "workingDirectory": ".",'
    echo '    "environment": {"PORT": "${ENMANNER_PORT}"},'
    printf '    "preferredPort": %d,\n' "$preferred_port"
    echo '    "readiness": {'
    echo '      "url": "http://127.0.0.1:${ENMANNER_PORT}/",'
    echo '      "timeoutSeconds": 30'
    echo '    }'
    echo '  },'
    echo '  "window": {'
    echo '    "mode": "browser",'
    echo '    "width": 1200,'
    echo '    "height": 800,'
    echo '    "resizable": true'
    echo '  }'
    echo '}'
  } > "$manifest_path"
fi

if [[ ! -e "$manifest_path" &&
  "$manifest_status" == "configurationRequired" &&
  ! -e "$draft_manifest_path" ]]; then
  draft_command="${candidate_command:-[\"REPLACE_WITH_PROJECT_COMMAND\"]}"
  {
    echo '{'
    echo '  "$schema": "../.enmanner/enmanner.schema.json",'
    echo '  "version": 2,'
    printf '  "name": "%s",\n' "$(json_escape "$project_name")"
    printf '  "identifier": "%s",\n' "$(json_escape "$bundle_identifier")"
    echo '  "server": {'
    printf '    "command": %s,\n' "$draft_command"
    printf '    "workingDirectory": "%s",\n' \
      "$(json_escape "$candidate_working_directory")"
    echo '    "environment": {},'
    printf '    "preferredPort": %d,\n' "$preferred_port"
    echo '    "readiness": {'
    echo '      "url": "http://127.0.0.1:${ENMANNER_PORT}/",'
    echo '      "timeoutSeconds": 30'
    echo '    }'
    echo '  },'
    echo '  "window": {'
    echo '    "mode": "browser",'
    echo '    "width": 1200,'
    echo '    "height": 800,'
    echo '    "resizable": true'
    echo '  }'
    echo '}'
  } > "$draft_manifest_path"
fi

gitignore="$target_dir/.gitignore"
if ! grep -q "# enmanner:begin" "$gitignore" 2>/dev/null; then
  {
    echo
    echo "# enmanner:begin"
    if [[ "$manifest_status" != "configurationRequired" ]]; then
      echo "$app_ignore"
    fi
    echo "/.enmanner/framework/.build/"
    echo "/.enmanner/.build/"
    echo "# enmanner:end"
  } >> "$gitignore"
fi

agents_file="$target_dir/AGENTS.md"
if ! grep -q "<!-- enmanner:begin -->" "$agents_file" 2>/dev/null; then
  {
    echo
    echo "<!-- enmanner:begin -->"
    echo "## Enmanner"
    echo
    echo "Enmanner is installed in this project. Read \`.enmanner/AGENTS.md\` before"
    echo "changing startup, networking, persistence, secrets, native presentation,"
    echo "or collaboration. Preserve the repository as the source of truth."
    echo "<!-- enmanner:end -->"
  } >> "$agents_file"
fi

if [[ "$json" == true ]]; then
  "$destination/scripts/record-installation" \
    --source "$source_dir" --manifest-status "$manifest_status" >/dev/null
else
  "$destination/scripts/record-installation" \
    --source "$source_dir" --manifest-status "$manifest_status"
fi

built=false
if [[ "$manifest_status" == "configurationRequired" ]]; then
  [[ "$json" == true ]] || {
    echo "✓ Installed framework files."
    echo "✓ Wrote enmanner/enmanner.json.example with preserved presentation choices."
    echo "! Configuration is required; review the draft and resolve the reported checks."
    echo "  No app was generated."
  }
elif [[ "$skip_build" == true ]]; then
  [[ "$json" == true ]] || echo "✓ Installed without building as requested."
else
  if [[ "$runtime_validation" == true ]]; then
    if [[ "$json" == true ]]; then
      "$destination/scripts/validate" --runtime --json >/dev/null
    else
      "$destination/scripts/validate" --runtime
    fi
  elif [[ "$json" != true ]]; then
    echo "Skipped runtime validation because it starts and stops project services."
  fi
  if [[ "$icon_configured" != true ]]; then
    if [[ "$runtime_validation" != true ]]; then
      if [[ "$json" == true ]]; then
        "$destination/scripts/validate" --json >/dev/null
      else
        "$destination/scripts/validate"
      fi
    fi
    [[ "$json" == true ]] || {
      echo "✓ Lifecycle configuration is ready for project-specific verification."
      echo "! A distinctive icon is required before building the app."
      echo "  Follow .enmanner/instructions/icon.md, then run ./.enmanner/scripts/build-app."
    }
  else
    build_args=()
    [[ "$allow_legacy_icon" == true ]] && build_args+=(--allow-legacy-icon)
    [[ "$replace_existing_app" == true ]] && build_args+=(--replace-existing-app)
    if [[ "$json" == true ]]; then
      if ! build_result="$(
        "$destination/scripts/build-app" "${build_args[@]}" --json
      )"; then
        printf '%s\n' "$build_result"
        exit 1
      fi
    else
      "$destination/scripts/build-app" "${build_args[@]}"
    fi
    built=true
  fi
fi

emit_result true "$built" install
