#!/bin/bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: install [options] /path/to/project

Options:
  --plan                 Inspect and report without changing the project
  --no-build             Install files but do not build the app
  --runtime              Opt in to state-changing runtime validation
  --json                 Emit one machine-readable result
  --repair               Repair or update an existing installation
  --replace-incomplete   Relocate an incomplete framework and install cleanly
  --upstream-url URL     Explicitly declare distribution provenance
  --name NAME            Set the generated application name
  --identifier ID        Set the generated bundle identifier
  --allow-legacy-icon    Permit an intentional legacy icon fallback
  --replace-existing-app Replace an app only after explicit collision review
  --allow-unversioned    Record an intentionally unversioned workspace
  --allow-subproject     Acknowledge an intentional nested/service-level app
EOF
}

json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  printf '%s' "$value"
}

plan=false
skip_build=false
runtime_validation=false
json=false
repair=false
replace_incomplete=false
allow_legacy_icon=false
replace_existing_app=false
allow_unversioned=false
allow_subproject=false
explicit_upstream_url=""
requested_name=""
requested_identifier=""
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --plan) plan=true ;;
    --no-build) skip_build=true ;;
    --runtime) runtime_validation=true ;;
    --json) json=true ;;
    --repair) repair=true ;;
    --replace-incomplete) replace_incomplete=true ;;
    --upstream-url)
      shift
      explicit_upstream_url="${1:-}"
      [[ -n "$explicit_upstream_url" ]] || { usage; exit 64; }
      ;;
    --allow-legacy-icon) allow_legacy_icon=true ;;
    --replace-existing-app) replace_existing_app=true ;;
    --allow-unversioned) allow_unversioned=true ;;
    --allow-subproject) allow_subproject=true ;;
    --name)
      shift
      requested_name="${1:-}"
      [[ -n "$requested_name" ]] || { usage; exit 64; }
      ;;
    --identifier)
      shift
      requested_identifier="${1:-}"
      [[ -n "$requested_identifier" ]] || { usage; exit 64; }
      ;;
    --help|-h) usage; exit 0 ;;
    *) usage; exit 64 ;;
  esac
  shift
done
[[ $# -eq 1 ]] || { usage; exit 64; }
if [[ "$skip_build" == true && "$runtime_validation" == true ]]; then
  echo "Error: --no-build and --runtime cannot be used together." >&2
  exit 64
fi
if [[ "$repair" == true && ( -n "$requested_name" || -n "$requested_identifier" ) ]]; then
  echo "Error: --name and --identifier do not apply to --repair." >&2
  exit 64
fi
if [[ "$repair" == true && "$replace_incomplete" == true ]]; then
  echo "Error: --repair and --replace-incomplete are mutually exclusive." >&2
  exit 64
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source_dir="$(cd "$script_dir/.." && pwd)"
source_repository_dir="$(cd "$source_dir/.." && pwd)"
target_dir="$(cd "$1" && /bin/pwd -P)"
destination="$target_dir/.enmanner"
configuration_dir="$target_dir/enmanner"
manifest_path="$configuration_dir/enmanner.json"
manifest_relative_path="enmanner/enmanner.json"
draft_manifest_path="$configuration_dir/enmanner.json.example"

toolchain_valid=true
if ! toolchain_result="$("$script_dir/toolchain-preflight" --json)"; then
  toolchain_valid=false
fi

installation_state="notInstalled"
installation_recovery="install"
if [[ -L "$destination" ]]; then
  installation_state="damaged"
  installation_recovery="replaceIncomplete"
elif [[ -e "$destination" && ! -d "$destination" ]]; then
  installation_state="damaged"
  installation_recovery="replaceIncomplete"
elif [[ -d "$destination" ]]; then
  if [[ -f "$destination/INSTALLATION.json" ]]; then
    if /usr/bin/plutil -extract formatVersion raw \
      "$destination/INSTALLATION.json" >/dev/null 2>&1 &&
      /usr/bin/plutil -extract version raw \
        "$destination/INSTALLATION.json" >/dev/null 2>&1 &&
      /usr/bin/plutil -extract files json -o /dev/null \
        "$destination/INSTALLATION.json" >/dev/null 2>&1; then
      installation_state="installed"
      installation_recovery="repair"
    else
      installation_state="damaged"
      installation_recovery="replaceIncomplete"
    fi
  else
    unexpected_installation_content=false
    [[ -L "$destination/framework" ]] &&
      unexpected_installation_content=true
    while IFS= read -r -d '' installed_path; do
      relative="${installed_path#"$destination"/}"
      case "$relative" in
        .build|.build/*|framework|framework/.build|framework/.build/*|\
          .DS_Store|framework/.DS_Store)
          ;;
        *)
          unexpected_installation_content=true
          break
          ;;
      esac
    done < <(find "$destination" -mindepth 1 -print0 2>/dev/null)
    if [[ "$unexpected_installation_content" == false ]]; then
      installation_state="cacheOnly"
      installation_recovery="removeGeneratedCacheAndInstall"
    elif [[ -f "$destination/VERSION" &&
      -x "$destination/scripts/upgrade" ]]; then
      installation_state="legacyWithoutReceipt"
      installation_recovery="replaceIncomplete"
    else
      installation_state="incomplete"
      installation_recovery="replaceIncomplete"
    fi
  fi
fi

source_git_common_dir=""
target_git_common_dir=""
shared_git_metadata=false
if command -v git >/dev/null 2>&1; then
  source_git_common_dir="$(
    git -C "$source_repository_dir" rev-parse \
      --path-format=absolute --git-common-dir 2>/dev/null || true
  )"
  target_git_common_dir="$(
    git -C "$target_dir" rev-parse \
      --path-format=absolute --git-common-dir 2>/dev/null || true
  )"
  if [[ -n "$source_git_common_dir" &&
    "$source_git_common_dir" == "$target_git_common_dir" ]]; then
    shared_git_metadata=true
  fi
fi

if [[ -e "$configuration_dir" &&
  "$configuration_dir" -ef "$source_repository_dir" ]]; then
  echo "Error: the Enmanner source checkout resolves to the project's" >&2
  echo "  enmanner/ configuration directory on this filesystem." >&2
  echo "  Move the Enmanner checkout outside $target_dir before installing;" >&2
  echo "  source code and project-owned configuration must be distinct paths." >&2
  exit 1
fi
if [[ -e "$configuration_dir/.git" ]]; then
  echo "Error: the project-owned enmanner/ configuration path is a Git checkout." >&2
  echo "  Move that checkout outside $target_dir before installing; on" >&2
  echo "  default macOS filesystems, Enmanner/ and enmanner/ collide." >&2
  exit 1
fi

[[ -w "$target_dir" || "$plan" == true ]] || {
  echo "Error: The project directory is not writable: $target_dir" >&2
  exit 1
}

while IFS= read -r -d '' root_manifest; do
  echo "Error: the manifest must live at enmanner/enmanner.json." >&2
  echo "  Remove the root-level $(basename "$root_manifest") before installing." >&2
  exit 1
done < <(find "$target_dir" -mindepth 1 -maxdepth 1 -type f \
  -iname 'enmanner.json' -print0)

git_classification="unversioned"
git_root=""
nested_repositories=0
while IFS= read -r -d '' ignored_git_marker; do
  nested_repositories=$((nested_repositories + 1))
done < <(find "$target_dir" -mindepth 2 -maxdepth 5 \
  \( -type d -o -type f \) -name .git \
  -not -path '*/node_modules/*' -print0 2>/dev/null)

if command -v git >/dev/null 2>&1 &&
  git_root="$(git -C "$target_dir" rev-parse --show-toplevel 2>/dev/null)"; then
  if [[ "$git_root" == "$target_dir" ]]; then
    git_classification="repository-root"
  elif [[ $nested_repositories -gt 0 ]]; then
    git_classification="workspace-with-nested-repositories"
  else
    git_classification="subdirectory-of-repository"
  fi
elif [[ $nested_repositories -gt 0 ]]; then
  git_classification="workspace-with-nested-repositories"
fi

scope_review_required=false
scope_reason="The proposed target has no strong service-subproject signal."
candidate_workspace_root=""
enclosing_enmanner_root=""
scope_cursor="$(dirname "$target_dir")"
while [[ "$scope_cursor" != "/" && "$scope_cursor" != "$target_dir" ]]; do
  if [[ -f "$scope_cursor/enmanner/enmanner.json" ||
    -f "$scope_cursor/.enmanner/INSTALLATION.json" ]]; then
    enclosing_enmanner_root="$scope_cursor"
    break
  fi
  next_scope_cursor="$(dirname "$scope_cursor")"
  [[ "$next_scope_cursor" != "$scope_cursor" ]] || break
  scope_cursor="$next_scope_cursor"
done

if [[ -n "$enclosing_enmanner_root" ]]; then
  scope_review_required=true
  candidate_workspace_root="$enclosing_enmanner_root"
  scope_reason="An enclosing Enmanner integration already exists at $enclosing_enmanner_root."
elif [[ "$git_classification" == "subdirectory-of-repository" ]]; then
  scope_review_required=true
  candidate_workspace_root="$git_root"
  scope_reason="The proposed target is inside the repository rooted at $git_root."
elif [[ "$git_classification" == "repository-root" ]]; then
  repository_parent="$(dirname "$target_dir")"
  target_role="$(basename "$target_dir" | tr '[:upper:]' '[:lower:]')"
  service_role_repositories=0
  while IFS= read -r -d '' sibling_git_marker; do
    sibling_name="$(basename "$(dirname "$sibling_git_marker")" | tr '[:upper:]' '[:lower:]')"
    case "$sibling_name" in
      frontend|front-end|web|client|backend|back-end|api|server|worker|database|db)
        service_role_repositories=$((service_role_repositories + 1))
        ;;
    esac
  done < <(find "$repository_parent" -mindepth 2 -maxdepth 2 \
    \( -type d -o -type f \) -name .git -print0 2>/dev/null)
  case "$target_role" in
    frontend|front-end|web|client|backend|back-end|api|server|worker|database|db)
      if [[ $service_role_repositories -gt 1 ]]; then
        scope_review_required=true
        candidate_workspace_root="$repository_parent"
        scope_reason="The proposed target and sibling Git repositories look like cooperating service repositories under $repository_parent."
      fi
      ;;
  esac
fi

git_branch=""
git_dirty=false
git_has_upstream=false
git_ahead=0
git_behind=0
if [[ -n "$git_root" ]]; then
  git_branch="$(git -C "$target_dir" symbolic-ref --short HEAD 2>/dev/null || true)"
  [[ -n "$(git -C "$target_dir" status --porcelain -- . 2>/dev/null)" ]] &&
    git_dirty=true
  ahead_behind="$(
    git -C "$target_dir" rev-list --left-right --count \
      '@{upstream}...HEAD' 2>/dev/null || true
  )"
  if [[ -n "$ahead_behind" ]]; then
    git_has_upstream=true
    git_behind="$(printf '%s' "$ahead_behind" | /usr/bin/awk '{print $1}')"
    git_ahead="$(printf '%s' "$ahead_behind" | /usr/bin/awk '{print $2}')"
  fi
fi

project_name="${requested_name:-$(basename "$target_dir")}"
directory_name="$(basename "$target_dir")"
package_name=""
package_display_name=""
if [[ -f "$target_dir/package.json" ]]; then
  package_name="$(
    /usr/bin/plutil -extract name raw "$target_dir/package.json" 2>/dev/null || true
  )"
  if [[ -n "$package_name" ]]; then
    package_display_name="$(
      printf '%s' "${package_name##*/}" |
        tr '_-' '  ' |
        /usr/bin/awk '{
          for (field_index = 1; field_index <= NF; field_index++) {
            $field_index = toupper(substr($field_index, 1, 1)) substr($field_index, 2)
          }
          print
        }'
    )"
  fi
fi
if [[ -f "$manifest_path" ]]; then
  existing_name="$(/usr/bin/plutil -extract name raw "$manifest_path" 2>/dev/null || true)"
  [[ -z "$requested_name" && -n "$existing_name" ]] && project_name="$existing_name"
fi
slug="$(printf '%s' "$project_name" |
  tr '[:upper:]' '[:lower:]' |
  sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
[[ -n "$slug" ]] || slug="app"
bundle_identifier="${requested_identifier:-local.enmanner.$slug}"
if [[ -f "$manifest_path" && -z "$requested_identifier" ]]; then
  existing_identifier="$(
    /usr/bin/plutil -extract identifier raw "$manifest_path" 2>/dev/null || true
  )"
  [[ -n "$existing_identifier" ]] && bundle_identifier="$existing_identifier"
fi
identifier_checksum="$(printf '%s' "$bundle_identifier" | /usr/bin/cksum | /usr/bin/awk '{print $1}')"
preferred_port=$((42000 + identifier_checksum % 6000))

package_manager=""
package_manager_signal=""
candidate_command=""
candidate_working_directory="."
candidate_inspect_path=""
detected_framework=""
manifest_status="configurationRequired"
inference_reason="No supported high-confidence startup command was found."
detected_stacks=()
detected_stack_count=0
express_source=""
express_port_evidence=""
express_host_evidence=""
express_listen_evidence=""
candidate_uses_port_environment=false
candidate_uses_host_environment=false
runtime_verification_required=false
possible_entry=""
runtime_search_paths=()
runtime_resolution_signals=()
candidate_component_graph=false
candidate_web_script=""
candidate_api_script=""

add_detected_stack() {
  local stack="$1"
  local existing
  if [[ $detected_stack_count -gt 0 ]]; then
    for existing in "${detected_stacks[@]}"; do
      [[ "$existing" == "$stack" ]] && return
    done
  fi
  detected_stacks+=("$stack")
  detected_stack_count=$((detected_stack_count + 1))
}

add_runtime_search_path() {
  local path="$1"
  local existing
  [[ -d "$path" ]] || return
  if [[ ${#runtime_search_paths[@]} -gt 0 ]]; then
    for existing in "${runtime_search_paths[@]}"; do
      [[ "$existing" == "$path" ]] && return
    done
  fi
  runtime_search_paths+=("$path")
}

if [[ -f "$target_dir/mise.toml" || -f "$target_dir/.mise.toml" ]]; then
  runtime_resolution_signals+=("mise")
  if command -v mise >/dev/null 2>&1; then
    resolved_runtime="$(cd "$target_dir" && mise which node 2>/dev/null || true)"
    [[ -n "$resolved_runtime" ]] && add_runtime_search_path "$(dirname "$resolved_runtime")"
  fi
fi
if [[ -f "$target_dir/.tool-versions" ]]; then
  runtime_resolution_signals+=("asdf")
  if command -v asdf >/dev/null 2>&1; then
    resolved_runtime="$(cd "$target_dir" && asdf which node 2>/dev/null || true)"
    [[ -n "$resolved_runtime" ]] && add_runtime_search_path "$(dirname "$resolved_runtime")"
  fi
fi
node_version_file=""
[[ -f "$target_dir/.nvmrc" ]] && node_version_file="$target_dir/.nvmrc"
[[ -z "$node_version_file" && -f "$target_dir/.node-version" ]] &&
  node_version_file="$target_dir/.node-version"
if [[ -n "$node_version_file" ]]; then
  runtime_resolution_signals+=("$(basename "$node_version_file")")
  requested_node_version="$(tr -d '[:space:]' < "$node_version_file")"
  requested_node_version="${requested_node_version#v}"
  nvm_root="${NVM_DIR:-${HOME:-}/.nvm}"
  for node_directory in \
    "$nvm_root/versions/node/v$requested_node_version/bin" \
    "$nvm_root/versions/node/$requested_node_version/bin"; do
    [[ -x "$node_directory/node" ]] && add_runtime_search_path "$node_directory"
  done
fi

if [[ -f "$target_dir/package.json" ]]; then
  add_detected_stack "Node.js"
  candidate_inspect_path="package.json"
  if /usr/bin/plutil -extract dependencies.express raw \
    "$target_dir/package.json" >/dev/null 2>&1 ||
    /usr/bin/plutil -extract devDependencies.express raw \
      "$target_dir/package.json" >/dev/null 2>&1; then
    add_detected_stack "Express"
    for express_candidate in server.js server.mjs server.cjs index.js app.js; do
      if [[ -f "$target_dir/$express_candidate" ]]; then
        express_source="$express_candidate"
        break
      fi
    done
    if [[ -n "$express_source" ]]; then
      express_port_evidence="$(
        /usr/bin/grep -En 'process[.]env[.]PORT|process[.]env\\[['"'"'"]PORT['"'"'"]\\]' \
          "$target_dir/$express_source" | /usr/bin/head -n 1 || true
      )"
      express_host_evidence="$(
        /usr/bin/grep -En \
          '127[.]0[.]0[.]1|localhost|process[.]env[.]HOST|process[.]env\\[['"'"'"]HOST['"'"'"]\\]' \
          "$target_dir/$express_source" | /usr/bin/head -n 1 || true
      )"
      express_listen_evidence="$(
        /usr/bin/grep -En \
          'app[.]listen[[:space:]]*[(][[:space:]]*PORT[[:space:]]*,[[:space:]]*HOST[[:space:]]*[,)]' \
          "$target_dir/$express_source" | /usr/bin/head -n 1 || true
      )"
      [[ -n "$express_port_evidence" ]] &&
        candidate_uses_port_environment=true
      [[ -n "$express_host_evidence" ]] &&
        candidate_uses_host_environment=true
    fi
  fi

  declared_package_manager="$(
    /usr/bin/plutil -extract packageManager raw \
      "$target_dir/package.json" 2>/dev/null || true
  )"
  declared_package_manager_name=""
  if [[ -n "$declared_package_manager" ]]; then
    if [[ "$declared_package_manager" =~ ^(npm|pnpm|yarn|bun)@.+$ ]]; then
      declared_package_manager_name="${BASH_REMATCH[1]}"
    else
      inference_reason="The root packageManager field is unsupported or malformed: $declared_package_manager"
    fi
  fi

  lockfile_managers=()
  [[ -f "$target_dir/package-lock.json" ||
    -f "$target_dir/npm-shrinkwrap.json" ]] &&
    lockfile_managers+=("npm")
  [[ -f "$target_dir/pnpm-lock.yaml" ]] &&
    lockfile_managers+=("pnpm")
  [[ -f "$target_dir/yarn.lock" ]] &&
    lockfile_managers+=("yarn")
  [[ -f "$target_dir/bun.lock" || -f "$target_dir/bun.lockb" ]] &&
    lockfile_managers+=("bun")

  package_manager_conflict=false
  if [[ ${#lockfile_managers[@]} -gt 1 ]]; then
    package_manager_conflict=true
    inference_reason="Conflicting root lockfiles were found for: ${lockfile_managers[*]}. Remove stale lockfiles or declare one verified package manager."
  elif [[ -n "$declared_package_manager" &&
    -z "$declared_package_manager_name" ]]; then
    package_manager_conflict=true
  elif [[ -n "$declared_package_manager_name" &&
    ${#lockfile_managers[@]} -eq 1 &&
    "${lockfile_managers[0]}" != "$declared_package_manager_name" ]]; then
    package_manager_conflict=true
    inference_reason="The packageManager field selects $declared_package_manager_name, but the root lockfile selects ${lockfile_managers[0]}. Resolve the conflicting package-manager signals."
  fi

  if [[ "$package_manager_conflict" != true ]]; then
    if [[ -n "$declared_package_manager_name" ]]; then
      package_manager="$declared_package_manager_name"
      package_manager_signal="packageManager"
    elif [[ ${#lockfile_managers[@]} -eq 1 ]]; then
      package_manager="${lockfile_managers[0]}"
      package_manager_signal="lockfile"
    else
      package_manager="npm"
      package_manager_signal="default"
    fi
  fi

  selected_script=""
  selected_script_value=""
  for script_name in dev start serve; do
    selected_script_value="$(
      /usr/bin/plutil -extract "scripts.$script_name" raw \
        "$target_dir/package.json" 2>/dev/null || true
    )"
    if [[ -n "$selected_script_value" ]]; then
      selected_script="$script_name"
      break
    fi
  done
  if [[ -n "$selected_script" &&
    "$package_manager_conflict" != true &&
    -n "$package_manager" ]]; then
    if [[ "$package_manager" == "npm" ]]; then
      candidate_command="[\"npm\", \"run\", \"$selected_script\"]"
    else
      candidate_command="[\"$package_manager\", \"run\", \"$selected_script\"]"
    fi
    inference_reason="Found the root $package_manager script '$selected_script'; host and dynamic-port behavior remain unverified."
    if [[ "$selected_script_value" =~ ^node[[:space:]]+([^[:space:]]+) ]]; then
      possible_entry="${BASH_REMATCH[1]}"
      possible_entry="${possible_entry#./}"
      if [[ "$possible_entry" != /* &&
        -f "$target_dir/$possible_entry" ]]; then
        candidate_inspect_path="$possible_entry"
      fi
    fi
  fi

  has_vite_dependency=false
  has_next_dependency=false
  has_vinext_dependency=false
  for dependency_section in dependencies devDependencies; do
    if /usr/bin/plutil -extract "$dependency_section.vite" raw \
      "$target_dir/package.json" >/dev/null 2>&1; then
      has_vite_dependency=true
    fi
    if /usr/bin/plutil -extract "$dependency_section.next" raw \
      "$target_dir/package.json" >/dev/null 2>&1; then
      has_next_dependency=true
    fi
    if /usr/bin/plutil -extract "$dependency_section.vinext" raw \
      "$target_dir/package.json" >/dev/null 2>&1; then
      has_vinext_dependency=true
    fi
  done

  framework_conflict=false
  if [[ "$has_vinext_dependency" == true ]]; then
    detected_framework="vinext"
    add_detected_stack "Vinext"
  elif [[ "$has_vite_dependency" == true && "$has_next_dependency" == true ]]; then
    framework_conflict=true
    inference_reason="Both Vite and Next.js are direct root dependencies; choose and verify the launcher command explicitly."
  elif [[ "$has_vite_dependency" == true ]]; then
    detected_framework="vite"
    add_detected_stack "Vite"
  elif [[ "$has_next_dependency" == true ]]; then
    detected_framework="next"
    add_detected_stack "Next.js"
  fi

  script_matches_adapter=false
  if [[ "$detected_framework" == "vite" &&
    "$selected_script" == "dev" &&
    "$selected_script_value" =~ ^vite([[:space:]]+(dev|serve))?[[:space:]]*$ ]]; then
    script_matches_adapter=true
  elif [[ "$detected_framework" == "next" &&
    "$selected_script" == "dev" &&
    "$selected_script_value" =~ ^next[[:space:]]+dev([[:space:]]+(--turbopack|--turbo|--webpack))?[[:space:]]*$ ]]; then
    script_matches_adapter=true
  elif [[ "$detected_framework" == "vinext" &&
    "$selected_script" == "dev" &&
    "$selected_script_value" =~ ^vinext[[:space:]]+dev([[:space:]]+--turbopack)?[[:space:]]*$ ]]; then
    script_matches_adapter=true
  fi

  if [[ "$package_manager_conflict" != true &&
    "$framework_conflict" != true &&
    "$script_matches_adapter" == true ]]; then
    case "$package_manager:$detected_framework" in
      npm:vite)
        candidate_command='["npm", "run", "dev", "--", "--host", "127.0.0.1", "--port", "${self.endpoints.http.port}", "--strictPort"]'
        ;;
      pnpm:vite)
        candidate_command='["pnpm", "run", "dev", "--host", "127.0.0.1", "--port", "${self.endpoints.http.port}", "--strictPort"]'
        ;;
      yarn:vite)
        candidate_command='["yarn", "run", "dev", "--host", "127.0.0.1", "--port", "${self.endpoints.http.port}", "--strictPort"]'
        ;;
      bun:vite)
        candidate_command='["bun", "run", "dev", "--host", "127.0.0.1", "--port", "${self.endpoints.http.port}", "--strictPort"]'
        ;;
      npm:next)
        candidate_command='["npm", "run", "dev", "--", "--hostname", "127.0.0.1", "--port", "${self.endpoints.http.port}"]'
        ;;
      pnpm:next)
        candidate_command='["pnpm", "run", "dev", "--hostname", "127.0.0.1", "--port", "${self.endpoints.http.port}"]'
        ;;
      yarn:next)
        candidate_command='["yarn", "run", "dev", "--hostname", "127.0.0.1", "--port", "${self.endpoints.http.port}"]'
        ;;
      bun:next)
        candidate_command='["bun", "run", "dev", "--hostname", "127.0.0.1", "--port", "${self.endpoints.http.port}"]'
        ;;
      npm:vinext)
        candidate_command='["npm", "run", "dev", "--", "--hostname", "127.0.0.1", "--port", "${self.endpoints.http.port}"]'
        ;;
      pnpm:vinext)
        candidate_command='["pnpm", "run", "dev", "--hostname", "127.0.0.1", "--port", "${self.endpoints.http.port}"]'
        ;;
      yarn:vinext)
        candidate_command='["yarn", "run", "dev", "--hostname", "127.0.0.1", "--port", "${self.endpoints.http.port}"]'
        ;;
      bun:vinext)
        candidate_command='["bun", "run", "dev", "--hostname", "127.0.0.1", "--port", "${self.endpoints.http.port}"]'
        ;;
    esac
    if [[ -n "$candidate_command" ]]; then
      manifest_status="inferred"
      inference_reason="Verified a root $package_manager $detected_framework development script with explicit loopback and dynamic-port arguments."
    fi
  elif [[ "$package_manager_conflict" != true &&
    "$framework_conflict" != true &&
    -n "$detected_framework" &&
    "$selected_script" == "dev" ]]; then
    inference_reason="Detected $detected_framework with package manager $package_manager, but the root dev script is not a tested direct framework command."
  fi
  if [[ "$package_manager_conflict" != true &&
    "$framework_conflict" != true &&
    -z "$detected_framework" &&
    -n "$express_source" &&
    "$possible_entry" == "$express_source" &&
    "$selected_script_value" =~ ^node[[:space:]]+(\./)?[^[:space:]]+[[:space:]]*$ &&
    -n "$express_port_evidence" &&
    -n "$express_host_evidence" &&
    -n "$express_listen_evidence" ]]; then
    detected_framework="express"
    manifest_status="inferred"
    runtime_verification_required=true
    inference_reason="Inferred a direct Express entry point with explicit PORT and HOST flow; runtime verification is still required."
  fi

  candidate_web_script_value="$(
    /usr/bin/plutil -extract 'scripts.dev:web' raw \
      "$target_dir/package.json" 2>/dev/null || true
  )"
  candidate_api_script_value="$(
    /usr/bin/plutil -extract 'scripts.dev:api' raw \
      "$target_dir/package.json" 2>/dev/null || true
  )"
  vite_configuration="$(find "$target_dir" -maxdepth 1 -type f \
    \( -name 'vite.config.js' -o -name 'vite.config.mjs' \
    -o -name 'vite.config.ts' -o -name 'vite.config.cjs' \) -print -quit)"
  api_entry=""
  if [[ "$candidate_api_script_value" =~ ^node[[:space:]]+(--watch[[:space:]]+)?([^[:space:]]+)[[:space:]]*$ ]]; then
    api_entry="${BASH_REMATCH[2]#./}"
  fi
  vite_proxy_evidence=false
  if [[ -n "$vite_configuration" ]] &&
    /usr/bin/grep -Eq 'proxy[[:space:]]*:' "$vite_configuration" &&
    /usr/bin/grep -Eq 'API_PORT|process[.]env[.]API_PORT' "$vite_configuration"; then
    vite_proxy_evidence=true
  fi
  if [[ "$has_vite_dependency" == true && -n "$express_source" &&
    "$candidate_web_script_value" =~ ^vite([[:space:]]+(dev|serve))?[[:space:]]*$ &&
    -n "$api_entry" && "$api_entry" == "$express_source" &&
    -n "$vite_configuration" &&
    -n "$express_port_evidence" && -n "$express_host_evidence" &&
    -n "$express_listen_evidence" &&
    "$vite_proxy_evidence" == true ]]; then
    candidate_component_graph=true
    candidate_web_script="dev:web"
    candidate_api_script="dev:api"
    candidate_api_command="[\"$package_manager\", \"run\", \"dev:api\"]"
    if [[ "$package_manager" == "npm" ]]; then
      candidate_web_command='["npm", "run", "dev:web", "--", "--host", "127.0.0.1", "--port", "${self.endpoints.http.port}", "--strictPort"]'
    else
      candidate_web_command="[\"$package_manager\", \"run\", \"dev:web\", \"--host\", \"127.0.0.1\", \"--port\", \"\${self.endpoints.http.port}\", \"--strictPort\"]"
    fi
    manifest_status="configurationRequired"
    runtime_verification_required=true
    inference_reason="Detected a root Vite frontend and Express API with matching package scripts, dynamic API port flow, and a Vite proxy. A two-service component-graph draft was generated for runtime verification."
  fi
else
  nested_package=""
  while IFS= read -r candidate_package; do
    if [[ -n "$nested_package" ]]; then
      nested_package="multiple"
      break
    fi
    nested_package="$candidate_package"
  done < <(find "$target_dir" -mindepth 2 -maxdepth 4 -name package.json \
    -not -path '*/node_modules/*' -print 2>/dev/null | sort)
  [[ -n "$nested_package" ]] && add_detected_stack "Node.js"
  if [[ -n "$nested_package" && "$nested_package" != "multiple" ]]; then
    relative_package="${nested_package#"$target_dir"/}"
    candidate_working_directory="$(dirname "$relative_package")"
    candidate_inspect_path="$relative_package"
    inference_reason="Found one nested package.json at ${nested_package#"$target_dir"/}; startup and port behavior require review."
  elif [[ "$nested_package" == "multiple" ]]; then
    inference_reason="Found multiple nested packages; choose a project-owned foreground supervisor."
  fi
fi

compose_path="$(find "$target_dir" -maxdepth 4 -not -path '*/node_modules/*' \
  \( -name 'compose.yml' -o -name 'compose.yaml' \
  -o -name 'docker-compose.yml' -o -name 'docker-compose.yaml' \) \
  -print -quit 2>/dev/null)"
if [[ -n "$compose_path" ]]; then
  add_detected_stack "Docker Compose"
  [[ -n "$candidate_inspect_path" ]] ||
    candidate_inspect_path="${compose_path#"$target_dir"/}"
fi
makefile_path="$(
  find "$target_dir" -maxdepth 4 -not -path '*/node_modules/*' \
    -name Makefile -print -quit 2>/dev/null
)"
if [[ -n "$makefile_path" ]]; then
  add_detected_stack "Make"
  [[ -n "$candidate_inspect_path" ]] ||
    candidate_inspect_path="${makefile_path#"$target_dir"/}"
fi
go_mod_path="$(find "$target_dir" -maxdepth 4 -name go.mod -print -quit 2>/dev/null)"
if [[ -n "$go_mod_path" ]]; then
  add_detected_stack "Go"
  [[ -n "$candidate_inspect_path" ]] ||
    candidate_inspect_path="${go_mod_path#"$target_dir"/}"
fi
cargo_path="$(find "$target_dir" -maxdepth 4 -name Cargo.toml -print -quit 2>/dev/null)"
if [[ -n "$cargo_path" ]]; then
  add_detected_stack "Cargo"
  [[ -n "$candidate_inspect_path" ]] ||
    candidate_inspect_path="${cargo_path#"$target_dir"/}"
fi
python_path="$(find "$target_dir" -maxdepth 4 \
  \( -name pyproject.toml -o -name requirements.txt \) \
  -print -quit 2>/dev/null)"
if [[ -n "$python_path" ]]; then
  add_detected_stack "Python"
  [[ -n "$candidate_inspect_path" ]] ||
    candidate_inspect_path="${python_path#"$target_dir"/}"
fi

if [[ -f "$manifest_path" ]]; then
  manifest_status="existing"
  inference_reason="An existing project-owned $manifest_relative_path will be preserved."
elif [[ "$manifest_status" == "configurationRequired" &&
  "$inference_reason" == "No supported high-confidence startup command was found." &&
  $detected_stack_count -gt 0 ]]; then
  inference_reason="Detected ${detected_stacks[*]}, but no tested high-confidence adapter matched. Hand-author the manifest using the reported evidence and compatibility checks."
fi
if [[ "$scope_review_required" == true && "$allow_subproject" != true &&
  "$manifest_status" == "inferred" ]]; then
  manifest_status="configurationRequired"
  inference_reason="$scope_reason Verify the product root before accepting the detected startup command."
fi

escaped_app_name="$project_name"
escaped_app_name="${escaped_app_name//\\/\\\\}"
escaped_app_name="${escaped_app_name//\[/\\[}"
escaped_app_name="${escaped_app_name//\]/\\]}"
escaped_app_name="${escaped_app_name//\*/\\*}"
escaped_app_name="${escaped_app_name//\?/\\?}"
escaped_app_name="${escaped_app_name//#/\\#}"
escaped_app_name="${escaped_app_name//!/\\!}"
app_ignore="/$escaped_app_name.app/"
icon_configured=false
if [[ -f "$manifest_path" ]]; then
  existing_icon="$(
    /usr/bin/plutil -extract icon.modern raw "$manifest_path" 2>/dev/null ||
      /usr/bin/plutil -extract icon.legacy raw "$manifest_path" 2>/dev/null ||
      /usr/bin/plutil -extract icon raw "$manifest_path" 2>/dev/null ||
      true
  )"
  [[ -n "$existing_icon" ]] && icon_configured=true
fi

gitignore_needs_update=true
grep -q "# enmanner:begin" "$target_dir/.gitignore" 2>/dev/null &&
  gitignore_needs_update=false
agents_needs_update=true
grep -q "<!-- enmanner:begin -->" "$target_dir/AGENTS.md" 2>/dev/null &&
  agents_needs_update=false
claude_needs_update=false
if [[ -f "$target_dir/CLAUDE.md" ]] &&
  ! grep -q "<!-- enmanner:begin -->" "$target_dir/CLAUDE.md" 2>/dev/null; then
  claude_needs_update=true
fi
other_agent_files=()
other_agent_file_count=0
unmanaged_other_agent_file_count=0
for agent_file in CLAUDE.md GEMINI.md .github/copilot-instructions.md; do
  if [[ -f "$target_dir/$agent_file" ]]; then
    other_agent_files+=("$agent_file")
    other_agent_file_count=$((other_agent_file_count + 1))
    [[ "$agent_file" == "CLAUDE.md" ]] ||
      unmanaged_other_agent_file_count=$((unmanaged_other_agent_file_count + 1))
  fi
done
if [[ -d "$target_dir/.cursor/rules" ]]; then
  other_agent_files+=(".cursor/rules/")
  other_agent_file_count=$((other_agent_file_count + 1))
  unmanaged_other_agent_file_count=$((unmanaged_other_agent_file_count + 1))
fi
stale_draft=false
[[ -f "$manifest_path" && -f "$draft_manifest_path" ]] &&
  stale_draft=true
manifest_will_write=false
[[ ! -e "$manifest_path" && "$manifest_status" == "inferred" ]] &&
  manifest_will_write=true
draft_will_write=false
[[ ! -e "$manifest_path" &&
  "$manifest_status" == "configurationRequired" &&
  ! -e "$draft_manifest_path" ]] &&
  draft_will_write=true

will_build=true
if [[ "$plan" == true || "$skip_build" == true ||
  "$manifest_status" == "configurationRequired" ||
  "$icon_configured" != true ]]; then
  will_build=false
fi
will_test_app=false
[[ "$will_build" == true && "$runtime_validation" == true ]] &&
  will_test_app=true
native_launch_verified=false
development_native_launch_verified=false
installation_applicable=false
case "$installation_state" in
  notInstalled|cacheOnly)
    [[ "$replace_incomplete" == false ]] && installation_applicable=true
    ;;
  incomplete|legacyWithoutReceipt|damaged)
    [[ "$replace_incomplete" == true ]] && installation_applicable=true
    ;;
esac
if [[ "$scope_review_required" == true && "$allow_subproject" != true ]]; then
  installation_applicable=false
fi
effective_agents_write=false
effective_claude_write=false
effective_gitignore_write=false
effective_manifest_write=false
effective_draft_write=false
if [[ "$installation_applicable" == true ]]; then
  [[ "$agents_needs_update" == true ]] && effective_agents_write=true
  [[ "$claude_needs_update" == true ]] && effective_claude_write=true
  [[ "$gitignore_needs_update" == true ]] && effective_gitignore_write=true
  [[ "$manifest_will_write" == true ]] && effective_manifest_write=true
  [[ "$draft_will_write" == true ]] && effective_draft_write=true
fi
replacement_backup=""

emit_result() {
  local installed="$1"
  local built="$2"
  local action="$3"
  local completion_status="installed"
  if [[ "$built" == true && "$native_launch_verified" == true ]]; then
    completion_status="complete"
  elif [[ "$built" == true ]]; then
    completion_status="nativeLaunchVerificationRequired"
  elif [[ "$manifest_status" == "configurationRequired" ]]; then
    completion_status="configurationRequired"
  elif [[ "$icon_configured" != true ]]; then
    completion_status="iconRequired"
  fi
  if [[ "$json" == true ]]; then
    printf '{'
    printf '"schemaVersion":1,'
    printf '"action":"%s",' "$(json_escape "$action")"
    printf '"target":"%s",' "$(json_escape "$target_dir")"
    printf '"installationState":"%s",' "$installation_state"
    printf '"installationApplicable":%s,' "$installation_applicable"
    printf '"safeRecovery":{"action":"%s","automatic":%s},' \
      "$installation_recovery" \
      "$([[ "$installation_state" == "cacheOnly" ]] && echo true || echo false)"
    printf '"recoveryBackup":%s,' \
      "$([[ -n "$replacement_backup" ]] &&
        printf '"%s"' "$(json_escape "$replacement_backup")" || printf 'null')"
    printf '"installed":%s,' "$installed"
    printf '"completionStatus":"%s",' "$completion_status"
    printf '"manifestStatus":"%s",' "$(json_escape "$manifest_status")"
    printf '"configurationRequired":%s,' \
      "$([[ "$manifest_status" == "configurationRequired" ]] && echo true || echo false)"
    printf '"built":%s,' "$built"
    printf '"build":{"planned":%s,"iconConfigured":%s,"developmentBuildAvailable":%s,"developmentNativeLaunchTestPlanned":%s,"developmentNativeLaunchVerified":%s,"nativeLaunchTestPlanned":%s,"nativeLaunchVerified":%s,' \
      "$will_build" "$icon_configured" \
      "$([[ "$manifest_status" != "configurationRequired" ]] && echo true || echo false)" \
      "$([[ "$manifest_status" != "configurationRequired" && "$icon_configured" != true && "$runtime_validation" == true ]] && echo true || echo false)" \
      "$development_native_launch_verified" "$will_test_app" \
      "$native_launch_verified"
    if [[ "$manifest_status" == "configurationRequired" ]]; then
      printf '"blockedBy":"configurationRequired"},'
    elif [[ "$icon_configured" != true ]]; then
      printf '"blockedBy":"iconRequired"},'
    elif [[ "$plan" == true ]]; then
      printf '"blockedBy":"planOnly"},'
    elif [[ "$skip_build" == true ]]; then
      printf '"blockedBy":"noBuildRequested"},'
    else
      printf '"blockedBy":null},'
    fi
    printf '"git":{"classification":"%s","root":"%s","nestedRepositories":%d,"projectRootConfigurationTracked":%s,"requiresUnversionedAcknowledgement":%s,"branch":"%s","dirty":%s,"hasUpstream":%s,"ahead":%d,"behind":%d,"aheadBehindSource":"localRemoteTrackingRefs","networkAccessed":false},' \
      "$(json_escape "$git_classification")" "$(json_escape "$git_root")" \
      "$nested_repositories" \
      "$([[ "$git_classification" == "repository-root" || "$git_classification" == "subdirectory-of-repository" ]] && echo true || echo false)" \
      "$([[ "$git_classification" == "workspace-with-nested-repositories" ]] && echo true || echo false)" \
      "$(json_escape "$git_branch")" "$git_dirty" \
      "$git_has_upstream" "$git_ahead" "$git_behind"
    printf '"recommendedIntegrationRoot":"%s",' "$(json_escape "${candidate_workspace_root:-$target_dir}")"
    printf '"rootSelectionConfidence":"%s",' \
      "$([[ "$scope_review_required" == false && \
        ( "$git_classification" == "workspace-with-nested-repositories" || \
          "$git_classification" == "repository-root" ) ]] && echo high || echo medium)"
    printf '"configurationDurability":"%s",' \
      "$([[ "$git_classification" == "repository-root" || "$git_classification" == "subdirectory-of-repository" ]] && echo versioned || echo unversioned)"
    printf '"canProceedWithoutProductDecision":%s,' \
      "$([[ "$scope_review_required" == true ]] && echo false || echo true)"
    printf '"toolchain":%s,' "$toolchain_result"
    printf '"runtimeResolution":{"signals":['
    runtime_separator=""
    for runtime_signal in "${runtime_resolution_signals[@]:-}"; do
      [[ -n "$runtime_signal" ]] || continue
      printf '%s"%s"' "$runtime_separator" "$(json_escape "$runtime_signal")"
      runtime_separator=","
    done
    printf '],"executableSearchPaths":['
    runtime_separator=""
    for runtime_path in "${runtime_search_paths[@]:-}"; do
      [[ -n "$runtime_path" ]] || continue
      printf '%s"%s"' "$runtime_separator" "$(json_escape "$runtime_path")"
      runtime_separator=","
    done
    printf ']},'
    printf '"targetScope":{"reviewRequired":%s,"acknowledged":%s,"candidateWorkspaceRoot":%s,"enclosingEnmannerRoot":%s,"reason":"%s"},' \
      "$scope_review_required" "$allow_subproject" \
      "$([[ -n "$candidate_workspace_root" ]] && printf '"%s"' "$(json_escape "$candidate_workspace_root")" || printf 'null')" \
      "$([[ -n "$enclosing_enmanner_root" ]] && printf '"%s"' "$(json_escape "$enclosing_enmanner_root")" || printf 'null')" \
      "$(json_escape "$scope_reason")"
    printf '"detectedStacks":['
    detected_separator=""
    if [[ $detected_stack_count -gt 0 ]]; then
      for detected_stack in "${detected_stacks[@]}"; do
        printf '%s"%s"' "$detected_separator" "$(json_escape "$detected_stack")"
        detected_separator=","
      done
    fi
    printf '],'
    printf '"nameCandidates":['
    printf '{"value":"%s","source":"directory","confidence":0.6,"selected":%s}' \
      "$(json_escape "$directory_name")" \
      "$([[ -z "$requested_name" && "$project_name" == "$directory_name" ]] && echo true || echo false)"
    if [[ -n "$package_display_name" &&
      "$package_display_name" != "$directory_name" ]]; then
      printf ',{"value":"%s","source":"package.json","confidence":0.8,"selected":%s}' \
        "$(json_escape "$package_display_name")" \
        "$([[ -z "$requested_name" && "$project_name" == "$package_display_name" ]] && echo true || echo false)"
    fi
    if [[ -n "$requested_name" ]]; then
      printf ',{"value":"%s","source":"explicitOption","confidence":1.0,"selected":true}' \
        "$(json_escape "$requested_name")"
    fi
    printf '],'
    printf '"inference":{"packageManager":"%s","packageManagerSignal":"%s","framework":"%s","workingDirectory":"%s","command":%s,"componentGraphDraft":%s,"runtimeVerificationRequired":%s,"preferredPort":%d,"preferredPortDerivation":{"algorithm":"cksum-v1","identifier":"%s","rangeStart":42000,"rangeSize":6000},"reason":"%s","signalsExamined":["root package.json packageManager field","root npm, pnpm, Yarn, and Bun lockfiles","root package.json scripts dev/start/serve","root Vite, Next.js, or Vinext dependency","conservative Express source patterns","Vite proxy configuration","version-manager files","nested package.json files","Docker Compose files","Makefile","go.mod","Cargo.toml","pyproject.toml or requirements.txt"],"staticEvidence":[' \
      "$(json_escape "$package_manager")" \
      "$(json_escape "$package_manager_signal")" \
      "$(json_escape "$detected_framework")" \
      "$(json_escape "$candidate_working_directory")" \
      "${candidate_command:-null}" "$candidate_component_graph" "$runtime_verification_required" \
      "$preferred_port" \
      "$(json_escape "$bundle_identifier")" \
      "$(json_escape "$inference_reason")"
    evidence_separator=""
    if [[ -n "$express_port_evidence" ]]; then
      printf '%s{"check":"dynamicPort","status":"detected","source":"%s","evidence":"%s"}' \
        "$evidence_separator" "$(json_escape "$express_source")" \
        "$(json_escape "$express_port_evidence")"
      evidence_separator=","
    fi
    if [[ -n "$express_host_evidence" ]]; then
      printf '%s{"check":"loopbackBinding","status":"detected","source":"%s","evidence":"%s"}' \
        "$evidence_separator" "$(json_escape "$express_source")" \
        "$(json_escape "$express_host_evidence")"
      evidence_separator=","
    fi
    if [[ -n "$express_listen_evidence" ]]; then
      printf '%s{"check":"foregroundEntryPoint","status":"detected","source":"%s","evidence":"%s"}' \
        "$evidence_separator" "$(json_escape "$express_source")" \
        "$(json_escape "$express_listen_evidence")"
    fi
    printf '],"inspect":['
    if [[ -n "$candidate_inspect_path" ]]; then
      printf '"%s"' "$(json_escape "$candidate_inspect_path")"
    fi
    printf ']},'
    printf '"otherAgentInstructions":['
    other_agent_separator=""
    if [[ $other_agent_file_count -gt 0 ]]; then
      for agent_file in "${other_agent_files[@]}"; do
        printf '%s"%s"' "$other_agent_separator" "$(json_escape "$agent_file")"
        other_agent_separator=","
      done
    fi
    printf '],'
    printf '"fileOperations":['
    if [[ "$installation_state" == "cacheOnly" ]]; then
      printf '{"action":"removeGeneratedCache","path":".enmanner/","willWrite":%s},' \
        "$installation_applicable"
    elif [[ "$replace_incomplete" == true ]]; then
      printf '{"action":"relocateIncompleteFramework","path":".enmanner/","willWrite":%s},' \
        "$installation_applicable"
    fi
    printf '{"action":"createDirectory","path":".enmanner/","willWrite":%s},' \
      "$installation_applicable"
    printf '{"action":"createDirectory","path":"enmanner/","willWrite":%s},' \
      "$installation_applicable"
    printf '{"action":"ensureManagedSection","path":"AGENTS.md","willWrite":%s},' \
      "$effective_agents_write"
    if [[ -f "$target_dir/CLAUDE.md" ]]; then
      printf '{"action":"ensureManagedSection","path":"CLAUDE.md","willWrite":%s},' \
        "$effective_claude_write"
    fi
    printf '{"action":"ensureManagedSection","path":".gitignore","willWrite":%s},' \
      "$effective_gitignore_write"
    if [[ "$manifest_status" == "inferred" ]]; then
      printf '{"action":"create","path":"enmanner/enmanner.json","willWrite":%s}' \
        "$effective_manifest_write"
    elif [[ "$manifest_status" == "configurationRequired" ]]; then
      printf '{"action":"create","path":"enmanner/enmanner.json.example","willWrite":%s}' \
        "$effective_draft_write"
    else
      printf '{"action":"preserve","path":"%s","willWrite":false}' \
        "$manifest_relative_path"
    fi
    printf '],'
    printf '"performedWrites":['
    if [[ "$installed" == true ]]; then
      printf '".enmanner/","enmanner/"'
      [[ "$agents_needs_update" == true ]] &&
        printf ',"AGENTS.md managed section"'
      [[ "$claude_needs_update" == true ]] &&
        printf ',"CLAUDE.md managed section"'
      [[ "$gitignore_needs_update" == true ]] &&
        printf ',".gitignore managed section"'
      if [[ "$manifest_will_write" == true ]]; then
        printf ',"enmanner/enmanner.json"'
      elif [[ "$draft_will_write" == true ]]; then
        printf ',"enmanner/enmanner.json.example"'
      fi
    fi
    printf '],'
    printf '"unresolvedChecks":['
    unresolved_separator=""
    if [[ "$toolchain_valid" != true ]]; then
      printf '{"id":"appleToolchain","status":"failed","requirement":"the selected Apple developer tools compile Swift","evidence":"toolchain preflight failed","inspect":[],"suggestedChange":"select or reinstall Command Line Tools or Xcode using the structured toolchain diagnostic"}'
      unresolved_separator=","
    fi
    if [[ "$scope_review_required" == true && "$allow_subproject" != true ]]; then
      printf '{"id":"integrationRoot","status":"reviewRequired","requirement":"the target contains the complete launcher-owned runtime","evidence":"%s","inspect":["%s"],"suggestedChange":"run the installer against the common product workspace, or use --allow-subproject only for an intentional self-contained nested app"}' \
        "$(json_escape "$scope_reason")" \
        "$(json_escape "${candidate_workspace_root:-$(dirname "$target_dir")}")"
      unresolved_separator=","
    fi
    if [[ "$manifest_status" == "configurationRequired" ]]; then
      inspect_json="[]"
      if [[ -n "$candidate_inspect_path" ]]; then
        inspect_json="[\"$(json_escape "$candidate_inspect_path")\"]"
      fi
      if [[ -n "$express_port_evidence" ]]; then
        printf '%s{"id":"dynamicPort","status":"detected","requirement":"application uses its allocated endpoint port","evidence":"%s","inspect":["%s"],"suggestedChange":"confirm this static evidence with runtime validation"},' \
          "$unresolved_separator" "$(json_escape "$express_port_evidence")" "$(json_escape "$express_source")"
      else
        printf '%s{"id":"dynamicPort","status":"unknown","requirement":"application uses its allocated endpoint port","evidence":"startup candidate found but dynamic-port behavior is unverified","inspect":%s,"suggestedChange":"use ${self.endpoints.http.port} in the application command"},' "$unresolved_separator" "$inspect_json"
      fi
      if [[ -n "$express_host_evidence" ]]; then
        printf '{"id":"loopbackBinding","status":"detected","requirement":"server binds only to loopback","evidence":"%s","inspect":["%s"],"suggestedChange":"confirm this static evidence with runtime validation"},' \
          "$(json_escape "$express_host_evidence")" "$(json_escape "$express_source")"
      else
        printf '{"id":"loopbackBinding","status":"unknown","requirement":"server binds only to loopback","evidence":"startup candidate does not prove its listener host","inspect":%s,"suggestedChange":"bind the public listener explicitly to 127.0.0.1"},' "$inspect_json"
      fi
      printf '{"id":"foregroundLifecycle","status":"unknown","requirement":"managed services remain in the foreground","evidence":"child and daemon behavior requires project review","inspect":%s,"suggestedChange":"declare each owned process as a service component"}' "$inspect_json"
    fi
    printf '],'
    printf '"requiredInstructions":['
    printf '{"path":".enmanner/instructions/integration.md","reason":"normative integration sequence"},'
    printf '{"path":".enmanner/instructions/development-server.md","reason":"startup, networking, readiness, and shutdown are always required"},'
    if [[ -f "$target_dir/.env" || -f "$target_dir/.env.example" ||
      -n "$(find "$target_dir" -maxdepth 2 -iname 'docker-compose*.y*ml' -print -quit 2>/dev/null)" ]]; then
      printf '{"path":".enmanner/instructions/security.md","reason":"dotenv or container configuration was detected"},'
    fi
    if [[ -n "$(find "$target_dir" -maxdepth 3 \( -iname '*.sqlite' -o -iname '*.db' -o -iname 'docker-compose*.y*ml' \) -print -quit 2>/dev/null)" ]]; then
      printf '{"path":".enmanner/instructions/persistence.md","reason":"database or container state was detected"},'
    fi
    printf '{"path":".enmanner/instructions/icon.md","reason":"the first generated app requires finished native artwork"}],'
    printf '"nextActions":['
    if [[ "$manifest_status" == "configurationRequired" ]]; then
      printf '"reviewDraftManifest","resolveCompatibilityChecks",'
    fi
    if [[ "$manifest_status" != "configurationRequired" ]]; then
      printf '"validateLifecycle",'
    fi
    if [[ "$icon_configured" != true ]]; then
      printf '"buildDevelopmentApp","testDevelopmentApp",'
      printf '"createAndConfigureIcon",'
    fi
    printf '"finishIntegration"],'
    printf '"nextActionCommands":['
    if [[ "$manifest_status" != "configurationRequired" ]]; then
      printf '{"id":"validateLifecycle","command":["./.enmanner/scripts/validate","--runtime","--json"]},'
    fi
    printf '{"id":"inspectIntegrationState","command":["./.enmanner/scripts/doctor","--json"]},'
    if [[ "$icon_configured" != true ]]; then
      printf '{"id":"buildDevelopmentApp","command":["./.enmanner/scripts/build-app","--development","--json"]},'
      printf '{"id":"testDevelopmentApp","command":["./.enmanner/scripts/test-app","--development","--json"]},'
    fi
    printf '{"id":"finishIntegration","command":["./.enmanner/scripts/finish-integration","--runtime","--json"]}],'
    printf '"warnings":['
    warning_separator=""
    if [[ "$stale_draft" == true ]]; then
      printf '"%s.example remains beside the live manifest; remove the stale draft after confirming it is no longer needed"' \
        "$(json_escape "$manifest_relative_path")"
      warning_separator=","
    fi
    if [[ $unmanaged_other_agent_file_count -gt 0 ]]; then
      printf '%s"Other agent instruction files were detected; mirror the managed AGENTS.md guidance there when they are authoritative for this project"' "$warning_separator"
      warning_separator=","
    fi
    if [[ "$git_classification" == "workspace-with-nested-repositories" ]]; then
      printf '%s"The workspace root is not versioned even though nested repositories exist; enmanner/ and .enmanner/ at the root will remain untracked unless the root becomes a repository"' "$warning_separator"
      warning_separator=","
    fi
    if [[ "$scope_review_required" == true && "$allow_subproject" != true ]]; then
      printf '%s"Possible service-subproject target: %s Map the complete runtime and use the common workspace root when opening the app should start sibling services"' \
        "$warning_separator" "$(json_escape "$scope_reason")"
      warning_separator=","
    fi
    if [[ "$shared_git_metadata" == true ]]; then
      printf '%s"The Enmanner source checkout and target project share Git metadata; checkout remotes may not identify the Enmanner distribution, so use --upstream-url when declared distribution metadata is unavailable"' "$warning_separator"
    fi
    printf ']'
    printf '}\n'
  else
    echo "Enmanner $action for: $target_dir"
    echo "  Installation state: $installation_state"
    echo "  Git: $git_classification${git_root:+ ($git_root)}"
    if [[ "$scope_review_required" == true ]]; then
      echo "  Target scope: review required"
      echo "  $scope_reason"
      [[ "$allow_subproject" == true ]] ||
        echo "  Use the common workspace root, or acknowledge an intentional nested app with --allow-subproject."
    fi
    if [[ "$git_classification" == "workspace-with-nested-repositories" ]]; then
      echo "  Warning: root Enmanner configuration is not covered by the nested repositories."
      echo "  Initialize version control there, or record the unversioned workspace with --allow-unversioned."
    fi
    echo "  Manifest: $manifest_status"
    if [[ $detected_stack_count -gt 0 ]]; then
      echo "  Detected stacks: ${detected_stacks[*]}"
    fi
    [[ -n "$candidate_command" ]] && echo "  Candidate command: $candidate_command"
    echo "  $inference_reason"
    echo "  Files: .enmanner/, enmanner/, managed AGENTS.md and .gitignore sections"
    if [[ "$manifest_status" == "configurationRequired" ]]; then
      echo "  Draft: enmanner/enmanner.json.example"
    fi
    echo "  Build: $([[ "$will_build" == true ]] && echo planned || echo not-planned)"
    if [[ "$icon_configured" != true &&
      "$manifest_status" != "configurationRequired" ]]; then
      echo "  Completion: icon required before the final app can be built"
    fi
    [[ "$stale_draft" == true ]] &&
      echo "  Warning: remove stale $manifest_relative_path.example after confirming it is no longer needed"
    if [[ $other_agent_file_count -gt 0 ]]; then
      echo "  Agent instructions: also review ${other_agent_files[*]}"
      if [[ $unmanaged_other_agent_file_count -gt 0 ]]; then
        echo "  Mirror the managed AGENTS.md guidance when one of the unmanaged files is authoritative."
      fi
    fi
    if [[ "$shared_git_metadata" == true ]]; then
      echo "  Warning: source and target share Git metadata; verify distribution provenance."
    fi
  fi
}

if [[ "$plan" == true ]]; then
  if [[ "$repair" == true && "$installation_state" != "installed" ]]; then
    echo "Error: --repair requires a valid receipt-backed installation; state is $installation_state." >&2
    [[ "$installation_recovery" == "replaceIncomplete" ]] &&
      echo "Use --plan --replace-incomplete to inspect a recoverable replacement." >&2
    exit 1
  fi
  if [[ "$repair" == true ]]; then
    repair_plan_args=(--check --from "$source_dir" --target "$destination")
    [[ -n "$explicit_upstream_url" ]] &&
      repair_plan_args+=(--upstream-url "$explicit_upstream_url")
    [[ "$json" == true ]] && repair_plan_args+=(--json)
    "$source_dir/scripts/upgrade" "${repair_plan_args[@]}"
    exit 0
  fi
  emit_result false false plan
  exit 0
fi

if [[ "$toolchain_valid" != true ]]; then
  if [[ "$json" == true ]]; then
    printf '%s\n' "$toolchain_result"
  else
    "$script_dir/toolchain-preflight"
  fi
  exit 1
fi

if [[ "$repair" == true ]]; then
  if [[ "$installation_state" != "installed" ]]; then
    echo "Error: --repair requires a valid receipt-backed installation; state is $installation_state." >&2
    [[ "$installation_recovery" == "replaceIncomplete" ]] &&
      echo "Use --replace-incomplete to relocate it and install cleanly." >&2
    exit 1
  fi
  upgrade_args=(
    --apply --from "$source_dir" --target "$destination"
  )
  [[ -n "$explicit_upstream_url" ]] &&
    upgrade_args+=(--upstream-url "$explicit_upstream_url")
  [[ "$json" == true ]] && upgrade_args+=(--json)
  "$source_dir/scripts/upgrade" "${upgrade_args[@]}"
  exit 0
fi

if [[ "$replace_incomplete" == true ]]; then
  case "$installation_state" in
    incomplete|legacyWithoutReceipt|damaged)
      ;;
    *)
      echo "Error: --replace-incomplete does not apply to installation state $installation_state." >&2
      exit 1
      ;;
  esac
elif [[ "$installation_state" == "incomplete" ||
  "$installation_state" == "legacyWithoutReceipt" ||
  "$installation_state" == "damaged" ]]; then
  echo "Error: Enmanner installation state is $installation_state at $destination." >&2
  echo "Use --plan --replace-incomplete to inspect a recoverable clean installation." >&2
  exit 1
fi

if [[ "$git_classification" == "workspace-with-nested-repositories" &&
  "$allow_unversioned" != true ]]; then
  echo "Error: this target is a workspace containing nested repositories." >&2
  echo "  Install into a designated repository, or rerun with" >&2
  echo "  --allow-unversioned to record that the launcher configuration will" >&2
  echo "  be unversioned at this workspace root. When root selection is" >&2
  echo "  high-confidence, this acknowledgement needs no separate user decision." >&2
  exit 1
fi

if [[ "$scope_review_required" == true && "$allow_subproject" != true ]]; then
  echo "Error: the proposed target may be only one service of a larger application." >&2
  echo "  $scope_reason" >&2
  echo "  Run the plan against the common product workspace, or rerun with" >&2
  echo "  --allow-subproject only after confirming this is an intentional" >&2
  echo "  self-contained nested application." >&2
  exit 1
fi

if [[ "$json" != true ]]; then
  echo "Installing Enmanner into: $target_dir"
  echo "  Will copy framework-owned files into .enmanner/."
  echo "  Will keep project-owned integration files in enmanner/."
  echo "  Will update only managed sections in AGENTS.md and .gitignore."
  if [[ "$manifest_status" == "configurationRequired" ]]; then
    echo "  Will write an inactive enmanner/enmanner.json.example; no app will be built."
  elif [[ "$icon_configured" != true ]]; then
    echo "  Will validate configuration; no app will be built until an icon is configured."
  else
    echo "  Will validate configuration and build the configured app."
  fi
fi

if [[ "$installation_state" == "cacheOnly" ]]; then
  rm -rf "$destination/.build" "$destination/framework/.build"
  rm -f "$destination/.DS_Store" "$destination/framework/.DS_Store"
  rmdir "$destination/framework" 2>/dev/null || true
  rmdir "$destination" 2>/dev/null || true
  [[ "$json" == true ]] ||
    echo "✓ Removed disposable Enmanner build-cache residue."
elif [[ "$replace_incomplete" == true ]]; then
  replacement_backup="$target_dir/enmanner-framework-backup-$(
    date -u '+%Y%m%dT%H%M%SZ'
  )"
  [[ ! -e "$replacement_backup" ]] || {
    echo "Error: recovery backup already exists: $replacement_backup" >&2
    exit 1
  }
  mv "$destination" "$replacement_backup"
  [[ "$json" == true ]] ||
    echo "✓ Relocated incomplete framework to $replacement_backup"
fi

if [[ -e "$destination" ]]; then
  echo "Error: Enmanner is already present at $destination." >&2
  echo "Use --plan --repair to inspect or --repair to restore/update framework files." >&2
  exit 1
fi

mkdir -p "$destination" "$configuration_dir"
/usr/bin/rsync -a \
  --exclude ".build" \
  --exclude ".DS_Store" \
  --exclude "INSTALLATION.json" \
  --exclude "framework/Tests/" \
  --exclude "scripts/install" \
  "$source_dir/" "$destination/"

write_executable_search_paths() {
  [[ ${#runtime_search_paths[@]} -gt 0 ]] || return 0
  echo '  "executableSearchPaths": ['
  local index
  for ((index = 0; index < ${#runtime_search_paths[@]}; index++)); do
    suffix=","
    [[ $index -eq $((${#runtime_search_paths[@]} - 1)) ]] && suffix=""
    printf '    "%s"%s\n' \
      "$(json_escape "${runtime_search_paths[$index]}")" "$suffix"
  done
  echo '  ],'
}

if [[ ! -e "$manifest_path" && "$manifest_status" == "inferred" ]]; then
  {
    echo '{'
    echo '  "$schema": "../.enmanner/enmanner.schema.json",'
    echo '  "version": 3,'
    printf '  "name": "%s",\n' "$(json_escape "$project_name")"
    printf '  "identifier": "%s",\n' "$(json_escape "$bundle_identifier")"
    write_executable_search_paths
    echo '  "application": {'
    echo "    \"command\": $candidate_command,"
    echo '    "workingDirectory": ".",'
    if [[ "$candidate_uses_host_environment" == true ]]; then
      echo '    "environment": {'
      echo '      "PORT": "${self.endpoints.http.port}",'
      echo '      "HOST": "127.0.0.1"'
      echo '    },'
    else
      echo '    "environment": {"PORT": "${self.endpoints.http.port}"},'
    fi
    printf '    "preferredPort": %d,\n' "$preferred_port"
    echo '    "readiness": {'
    echo '      "path": "/",'
    echo '      "timeoutSeconds": 30'
    echo '    }'
    echo '  },'
    echo '  "window": {'
    echo '    "width": 1200,'
    echo '    "height": 800,'
    echo '    "resizable": true'
    echo '  }'
    echo '}'
  } > "$manifest_path"
fi

if [[ ! -e "$manifest_path" &&
  "$manifest_status" == "configurationRequired" &&
  ! -e "$draft_manifest_path" ]]; then
  draft_command="${candidate_command:-[\"REPLACE_WITH_PROJECT_COMMAND\"]}"
  {
    echo '{'
    echo '  "$schema": "../.enmanner/enmanner.schema.json",'
    echo '  "version": 3,'
    printf '  "name": "%s",\n' "$(json_escape "$project_name")"
    printf '  "identifier": "%s",\n' "$(json_escape "$bundle_identifier")"
    write_executable_search_paths
    if [[ "$candidate_component_graph" == true ]]; then
      echo '  "application": {'
      echo '    "component": "web",'
      echo '    "endpoint": "http"'
      echo '  },'
      echo '  "components": {'
      echo '    "api": {'
      echo '      "kind": "service",'
      printf '      "command": %s,\n' "$candidate_api_command"
      echo '      "environment": {'
      echo '        "PORT": "${self.endpoints.http.port}",'
      echo '        "HOST": "127.0.0.1"'
      echo '      },'
      echo '      "endpoints": {'
      echo '        "http": {"protocol": "http", "port": {}}'
      echo '      },'
      echo '      "readiness": {"endpoint": "http", "path": "/", "timeoutSeconds": 30}'
      echo '    },'
      echo '    "web": {'
      echo '      "kind": "service",'
      printf '      "command": %s,\n' "$candidate_web_command"
      echo '      "environment": {'
      echo '        "API_PORT": "${components.api.endpoints.http.port}"'
      echo '      },'
      echo '      "dependsOn": ["api"],'
      echo '      "endpoints": {'
      printf '        "http": {"protocol": "http", "port": {"preferred": %d}}\n' "$preferred_port"
      echo '      },'
      echo '      "readiness": {"endpoint": "http", "path": "/", "timeoutSeconds": 30}'
      echo '    }'
      echo '  },'
    else
      echo '  "application": {'
    printf '    "command": %s,\n' "$draft_command"
    printf '    "workingDirectory": "%s",\n' \
      "$(json_escape "$candidate_working_directory")"
    if [[ "$candidate_uses_port_environment" == true &&
      "$candidate_uses_host_environment" == true ]]; then
      echo '    "environment": {'
      echo '      "PORT": "${self.endpoints.http.port}",'
      echo '      "HOST": "127.0.0.1"'
      echo '    },'
    elif [[ "$candidate_uses_port_environment" == true ]]; then
      echo '    "environment": {"PORT": "${self.endpoints.http.port}"},'
    elif [[ "$candidate_uses_host_environment" == true ]]; then
      echo '    "environment": {"HOST": "127.0.0.1"},'
    else
      echo '    "environment": {},'
    fi
    printf '    "preferredPort": %d,\n' "$preferred_port"
    echo '    "readiness": {'
    echo '      "path": "/",'
    echo '      "timeoutSeconds": 30'
    echo '    }'
      echo '  },'
    fi
    echo '  "window": {'
    echo '    "width": 1200,'
    echo '    "height": 800,'
    echo '    "resizable": true'
    echo '  }'
    echo '}'
  } > "$draft_manifest_path"
fi

gitignore="$target_dir/.gitignore"
if ! grep -q "# enmanner:begin" "$gitignore" 2>/dev/null; then
  {
    echo
    echo "# enmanner:begin"
    if [[ "$manifest_status" != "configurationRequired" ]]; then
      echo "$app_ignore"
    fi
    echo "/.enmanner/framework/.build/"
    echo "/.enmanner/.build/"
    echo "# enmanner:end"
  } >> "$gitignore"
fi

agents_file="$target_dir/AGENTS.md"
if ! grep -q "<!-- enmanner:begin -->" "$agents_file" 2>/dev/null; then
  {
    echo
    echo "<!-- enmanner:begin -->"
    echo "## Enmanner"
    echo
    echo "Enmanner is installed in this project. Read \`.enmanner/AGENTS.md\` before"
    echo "changing startup, networking, persistence, secrets, native presentation,"
    echo "or collaboration. Preserve the repository as the source of truth."
    echo "<!-- enmanner:end -->"
  } >> "$agents_file"
fi

claude_file="$target_dir/CLAUDE.md"
if [[ -f "$claude_file" ]] &&
  ! grep -q "<!-- enmanner:begin -->" "$claude_file" 2>/dev/null; then
  {
    echo
    echo "<!-- enmanner:begin -->"
    echo "## Enmanner"
    echo
    echo "Enmanner is installed in this project. Read \`.enmanner/AGENTS.md\` before"
    echo "changing startup, networking, persistence, secrets, native presentation,"
    echo "or collaboration. Preserve the repository as the source of truth."
    echo "<!-- enmanner:end -->"
  } >> "$claude_file"
fi

record_args=(
  --source "$source_dir" --manifest-status "$manifest_status"
)
[[ -n "$explicit_upstream_url" ]] &&
  record_args+=(--upstream-url "$explicit_upstream_url")
[[ "$allow_unversioned" == true || "$git_classification" == "unversioned" ]] &&
  record_args+=(--unversioned-acknowledged)
if [[ "$json" == true ]]; then
  "$destination/scripts/record-installation" "${record_args[@]}" >/dev/null
else
  "$destination/scripts/record-installation" "${record_args[@]}"
fi

built=false
if [[ "$manifest_status" == "configurationRequired" ]]; then
  [[ "$json" == true ]] || {
    echo "✓ Installed framework files."
    echo "✓ Wrote enmanner/enmanner.json.example with preserved presentation choices."
    echo "! Configuration is required; review the draft and resolve the reported checks."
    echo "  No app was generated."
  }
elif [[ "$skip_build" == true ]]; then
  [[ "$json" == true ]] || echo "✓ Installed without building as requested."
else
  if [[ "$runtime_validation" == true ]]; then
    if [[ "$json" == true ]]; then
      "$destination/scripts/validate" --runtime --json >/dev/null
    else
      "$destination/scripts/validate" --runtime
    fi
  elif [[ "$json" != true ]]; then
    echo "Skipped runtime validation because it starts and stops project services."
  fi
  if [[ "$icon_configured" != true ]]; then
    if [[ "$runtime_validation" != true ]]; then
      if [[ "$json" == true ]]; then
        "$destination/scripts/validate" --json >/dev/null
      else
        "$destination/scripts/validate"
      fi
    fi
    if [[ "$runtime_validation" == true ]]; then
      if [[ "$json" == true ]]; then
        "$destination/scripts/build-app" --development --json >/dev/null
        "$destination/scripts/test-app" --development --json >/dev/null
      else
        "$destination/scripts/build-app" --development
        "$destination/scripts/test-app" --development
      fi
      development_native_launch_verified=true
    fi
    [[ "$json" == true ]] || {
      echo "✓ Lifecycle configuration is ready for project-specific verification."
      if [[ "$development_native_launch_verified" == true ]]; then
        echo "✓ The development-only native app lifecycle passed."
      fi
      echo "! A distinctive icon is required before building the final app."
      echo "  Follow .enmanner/instructions/icon.md, then run ./.enmanner/scripts/build-app."
    }
  else
    build_args=()
    [[ "$allow_legacy_icon" == true ]] && build_args+=(--allow-legacy-icon)
    [[ "$replace_existing_app" == true ]] && build_args+=(--replace-existing-app)
    if [[ "$json" == true ]]; then
      if ! build_result="$(
        "$destination/scripts/build-app" \
          ${build_args[@]+"${build_args[@]}"} --json
      )"; then
        printf '%s\n' "$build_result"
        exit 1
      fi
    else
      "$destination/scripts/build-app" ${build_args[@]+"${build_args[@]}"}
    fi
    built=true
    if [[ "$runtime_validation" == true ]]; then
      if [[ "$json" == true ]]; then
        if ! app_test_result="$(
          "$destination/scripts/test-app" --json
        )"; then
          printf '%s\n' "$app_test_result"
          exit 1
        fi
      else
        "$destination/scripts/test-app"
      fi
      native_launch_verified=true
    fi
  fi
fi

emit_result true "$built" install
