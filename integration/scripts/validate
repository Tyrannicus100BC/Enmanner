#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
integration_dir="$(cd "$script_dir/.." && pwd)"
project_dir="$(cd "$integration_dir/.." && pwd)"
framework_dir="$integration_dir/framework"
runtime_flag=""
doctor_flag=false
allow_legacy_icon=false
json=false

while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --runtime) runtime_flag="--runtime" ;;
    --doctor) doctor_flag=true ;;
    --allow-legacy-icon) allow_legacy_icon=true ;;
    --json) json=true ;;
    *)
      echo "Usage: $0 [--runtime] [--json] [--allow-legacy-icon]" >&2
      exit 64
      ;;
  esac
  shift
done
if [[ $# -ne 0 ]]; then
  echo "Usage: $0 [--runtime] [--json] [--allow-legacy-icon]" >&2
  exit 64
fi

if [[ -x "$script_dir/install" ]]; then
  echo "Error: integration/scripts/validate is installed-project tooling." >&2
  echo "  First run integration/scripts/install /path/to/project, then run" >&2
  echo "  ./.enmanner/scripts/validate from that target project." >&2
  exit 64
fi

if [[ -n "$runtime_flag" && "$json" != true ]]; then
  echo "Warning: runtime validation starts and stops the configured application." >&2
  echo "  It may mutate databases, containers, volumes, caches, or other local state." >&2
  echo "  Review state ownership and persistence before using it." >&2
fi

if ! command -v swift >/dev/null 2>&1; then
  echo "Error: Apple Command Line Tools are required. Ask your coding agent to install or select them." >&2
  exit 1
fi

[[ "$json" == true ]] || echo "Validating Enmanner configuration…"
if [[ "$json" == true ]]; then
  swift build --package-path "$framework_dir" -c release \
    --product enmanner-validator >/dev/null
else
  swift build --package-path "$framework_dir" -c release \
    --product enmanner-validator
fi
bin_dir="$(swift build --package-path "$framework_dir" -c release --show-bin-path)"

icon_path="$(
  /usr/bin/plutil -extract icon raw "$project_dir/enmanner.json" \
    2>/dev/null || true
)"
if [[ "$icon_path" == *.icns ]]; then
  if command -v xcrun >/dev/null 2>&1 &&
    xcrun --find actool >/dev/null 2>&1; then
    if [[ "$allow_legacy_icon" != true ]]; then
      echo "Error: $icon_path is a legacy .icns while modern icon tooling is available." >&2
      echo "  A standalone .icns can trigger the Tahoe compatibility enclosure (icon jail)." >&2
      echo "  Configure an Icon Composer .icon package, or rerun with" >&2
      echo "  --allow-legacy-icon only for an intentional compatibility fallback." >&2
      exit 1
    fi
    echo "Warning: allowing legacy .icns packaging by explicit request." >&2
    echo "  The app may appear inside the Tahoe compatibility enclosure (icon jail)." >&2
  else
    echo "Warning: using legacy .icns because Xcode actool is unavailable." >&2
    echo "  This is a compatibility fallback, not a native modern icon." >&2
  fi
fi

validator_args=(--project "$project_dir")
[[ -n "$runtime_flag" ]] && validator_args+=("$runtime_flag")
[[ "$doctor_flag" == true ]] && validator_args+=(--doctor)
[[ "$json" == true ]] && validator_args+=(--json)
"$bin_dir/enmanner-validator" "${validator_args[@]}"
[[ "$json" == true ]] || echo "✓ validator compiles with the active Apple toolchain"
