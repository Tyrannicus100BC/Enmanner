#!/bin/bash
set -euo pipefail

# Copy this file into the project (for example as ./start), then replace these
# example argument arrays with project commands. Do not convert them to strings
# or invoke them through eval.
backend_command=(make run-local)
frontend_command=(
  npm run dev --
  --host 127.0.0.1
  --port "${ENMANNER_PORT:?ENMANNER_PORT is required}"
  --strictPort
)

require_command() {
  local executable="$1"
  if ! command -v "$executable" >/dev/null 2>&1; then
    echo "Required executable is unavailable: $executable" >&2
    exit 1
  fi
}

require_directory() {
  local directory="$1"
  if [[ ! -d "$directory" ]]; then
    echo "Required project directory is missing: $directory" >&2
    exit 1
  fi
}

# Add project-specific prerequisite checks here. Observe external prerequisites
# such as Docker Desktop or a shared database; do not start, adopt, or stop them.
require_command make
require_command npm
require_directory Backend/backend
require_directory Frontend/frontend

pids=()
stopping=false

stop_children() {
  local index
  local pid
  if [[ "$stopping" == true ]]; then
    return
  fi
  stopping=true
  trap - TERM INT EXIT
  index="${#pids[@]}"
  while [[ "$index" -gt 0 ]]; do
    index=$((index - 1))
    pid="${pids[$index]}"
    if kill -0 "$pid" 2>/dev/null; then
      kill -TERM "$pid" 2>/dev/null || true
    fi
  done
  index="${#pids[@]}"
  while [[ "$index" -gt 0 ]]; do
    index=$((index - 1))
    pid="${pids[$index]}"
    wait "$pid" 2>/dev/null || true
  done
}

trap stop_children TERM INT EXIT

(
  cd Backend/backend
  exec "${backend_command[@]}"
) &
pids+=("$!")

# If the frontend requires a ready backend, poll a cheap project-owned health
# endpoint here before starting it. Keep the wait bounded and emit a useful
# error with recent service output when it fails.
(
  cd Frontend/frontend
  exec "${frontend_command[@]}"
) &
pids+=("$!")

# macOS ships Bash 3.2, which has no `wait -n`. Poll so that any unexpected
# required-service exit makes the foreground supervisor exit and lets Enmanner
# terminate the complete inherited process group.
while true; do
  for pid in "${pids[@]}"; do
    if ! kill -0 "$pid" 2>/dev/null; then
      if wait "$pid"; then
        status=0
      else
        status=$?
      fi
      echo "Required service PID $pid exited with status $status." >&2
      exit "$status"
    fi
  done
  sleep 0.2
done
