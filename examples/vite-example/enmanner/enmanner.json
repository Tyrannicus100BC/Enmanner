{
  "$schema": "../.enmanner/enmanner.schema.json",
  "version": 2,
  "name": "Enmanner Vite Example",
  "identifier": "local.enmanner.vite-example",
  "icon": "enmanner/icon/EnmannerViteExample.icon",
  "userConfiguration": {
    "file": ".env",
    "template": ".env.example",
    "fields": [
      {
        "key": "VITE_GREETING",
        "label": "Greeting",
        "description": "Shown as the main heading in the example app."
      },
      {
        "key": "VITE_TEAM_API_KEY",
        "label": "Team API Key",
        "type": "secret",
        "description": "Shows whether an example team credential is configured."
      }
    ]
  },
  "server": {
    "command": [
      "npm",
      "run",
      "dev",
      "--",
      "--host",
      "127.0.0.1",
      "--port",
      "${ENMANNER_PORT}",
      "--strictPort"
    ],
    "workingDirectory": ".",
    "environment": {
      "PORT": "${ENMANNER_PORT}"
    },
    "preferredPort": 43120,
    "readiness": {
      "url": "http://127.0.0.1:${ENMANNER_PORT}/",
      "timeoutSeconds": 30
    }
  },
  "window": {
    "mode": "browser",
    "width": 1200,
    "height": 800,
    "resizable": true
  }
}
