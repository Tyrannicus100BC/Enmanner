#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository_dir="$(cd "$script_dir/.." && pwd)"
test_root="$(mktemp -d "${TMPDIR:-/tmp}/Enmanner Install Tests.XXXXXX")"
cleanup() {
  rm -rf "$test_root"
}
trap cleanup EXIT

if "$repository_dir/integration/scripts/validate" --json \
  >"$test_root/source-validate.out" 2>&1; then
  echo "Error: source validate acted like installed-project tooling." >&2
  exit 1
fi
grep -Fq "First run integration/scripts/install" \
  "$test_root/source-validate.out"

vite_target="$test_root/Vite Project"
generic_target="$test_root/Generic Project"
workspace_target="$test_root/Workspace Project"
express_target="$test_root/Express Project"
cache_target="$test_root/Cache Only Project"
incomplete_target="$test_root/Incomplete Project"
legacy_target="$test_root/Legacy Project"
damaged_target="$test_root/Damaged Project"
root_manifest_target="$test_root/Root Manifest Project"
source_collision_target="$test_root/Source Collision Project"
checkout_collision_target="$test_root/Checkout Collision Project"
service_workspace="$test_root/Service Workspace"
adapter_root="$test_root/Adapter Projects"
mkdir -p "$vite_target" "$generic_target" \
  "$express_target" "$cache_target/.enmanner/.build" \
  "$cache_target/.enmanner/framework/.build" \
  "$incomplete_target/.enmanner" \
  "$legacy_target/.enmanner/scripts" \
  "$damaged_target/.enmanner" \
  "$workspace_target/Backend/.git" "$workspace_target/Frontend/.git" \
  "$root_manifest_target" "$source_collision_target" \
  "$checkout_collision_target/enmanner" \
  "$service_workspace/Frontend" "$service_workspace/Backend" "$adapter_root"
ln -s "$repository_dir" "$source_collision_target/enmanner"
git -C "$checkout_collision_target/enmanner" init -q
git -C "$service_workspace/Frontend" init -q
git -C "$service_workspace/Backend" init -q
cp "$repository_dir/examples/vite-example/package.json" \
  "$repository_dir/examples/vite-example/package-lock.json" \
  "$service_workspace/Frontend/"
cp "$repository_dir/examples/vite-example/package.json" \
  "$repository_dir/examples/vite-example/package-lock.json" \
  "$vite_target/"
cp "$repository_dir/examples/vite-example/package.json" \
  "$repository_dir/examples/vite-example/package-lock.json" \
  "$cache_target/"
cp "$repository_dir/examples/vite-example/package.json" \
  "$repository_dir/examples/vite-example/package-lock.json" \
  "$incomplete_target/"
cp "$repository_dir/examples/vite-example/package.json" \
  "$repository_dir/examples/vite-example/package-lock.json" \
  "$legacy_target/"
cp "$repository_dir/examples/vite-example/package.json" \
  "$repository_dir/examples/vite-example/package-lock.json" \
  "$damaged_target/"
printf '%s\n' 'cache' > "$cache_target/.enmanner/.build/cache"
printf '%s\n' 'cache' > "$cache_target/.enmanner/framework/.build/cache"
printf '%s\n' 'partial' > "$incomplete_target/.enmanner/VERSION"
printf '%s\n' '0.2.0' > "$legacy_target/.enmanner/VERSION"
printf '%s\n' '#!/bin/bash' > "$legacy_target/.enmanner/scripts/upgrade"
chmod +x "$legacy_target/.enmanner/scripts/upgrade"
printf '%s\n' '{not-json' > "$damaged_target/.enmanner/INSTALLATION.json"
cp "$repository_dir/tests/fixtures/generic-package.json" \
  "$generic_target/package.json"
printf '%s\n' '# Generic project instructions' > "$generic_target/CLAUDE.md"
printf '%s\n' \
  '{"private":true,"scripts":{"start":"node server.js"},"dependencies":{"express":"^5.0.0"}}' \
  > "$express_target/package.json"
printf '%s\n' \
  "const PORT = process.env.PORT || 3000;" \
  "const HOST = process.env.HOST || '127.0.0.1';" \
  "app.listen(PORT, HOST);" > "$express_target/server.js"
printf '%s\n' '{}' > "$root_manifest_target/enmanner.json"

write_adapter_project() {
  local package_manager="$1"
  local framework="$2"
  local target="$adapter_root/$package_manager-$framework"
  local script dependency version lockfile expected_command
  mkdir -p "$target"
  case "$framework" in
    vite)
      script="vite"
      dependency="vite"
      version="^7.0.0"
      ;;
    next)
      script="next dev"
      dependency="next"
      version="^16.0.0"
      ;;
    vinext)
      script="vinext dev"
      dependency="vinext"
      version="^0.0.0"
      ;;
  esac
  case "$package_manager" in
    npm)
      lockfile="package-lock.json"
      if [[ "$framework" == "vite" ]]; then
        expected_command='["npm","run","dev","--","--host","127.0.0.1","--port","${self.endpoints.http.port}","--strictPort"]'
      else
        expected_command='["npm","run","dev","--","--hostname","127.0.0.1","--port","${self.endpoints.http.port}"]'
      fi
      ;;
    pnpm)
      lockfile="pnpm-lock.yaml"
      if [[ "$framework" == "vite" ]]; then
        expected_command='["pnpm","run","dev","--host","127.0.0.1","--port","${self.endpoints.http.port}","--strictPort"]'
      else
        expected_command='["pnpm","run","dev","--hostname","127.0.0.1","--port","${self.endpoints.http.port}"]'
      fi
      ;;
    yarn)
      lockfile="yarn.lock"
      if [[ "$framework" == "vite" ]]; then
        expected_command='["yarn","run","dev","--host","127.0.0.1","--port","${self.endpoints.http.port}","--strictPort"]'
      else
        expected_command='["yarn","run","dev","--hostname","127.0.0.1","--port","${self.endpoints.http.port}"]'
      fi
      ;;
    bun)
      lockfile="bun.lock"
      if [[ "$framework" == "vite" ]]; then
        expected_command='["bun","run","dev","--host","127.0.0.1","--port","${self.endpoints.http.port}","--strictPort"]'
      else
        expected_command='["bun","run","dev","--hostname","127.0.0.1","--port","${self.endpoints.http.port}"]'
      fi
      ;;
  esac
  printf '%s\n' \
    "{\"private\":true,\"packageManager\":\"$package_manager@1.0.0\",\"scripts\":{\"dev\":\"$script\"},\"devDependencies\":{\"$dependency\":\"$version\"}}" \
    > "$target/package.json"
  : > "$target/$lockfile"
  "$repository_dir/integration/scripts/install" --plan --json "$target" |
    jq -e \
      --arg package_manager "$package_manager" \
      --arg framework "$framework" \
      --argjson expected_command "$expected_command" '
        (.manifestStatus == "inferred") and
        (.inference.packageManager == $package_manager) and
        (.inference.packageManagerSignal == "packageManager") and
        (.inference.framework == $framework) and
        (.inference.command == $expected_command) and
        (.unresolvedChecks | length == 0)
      ' >/dev/null
}

for adapter_package_manager in npm pnpm yarn bun; do
  for adapter_framework in vite next vinext; do
    write_adapter_project "$adapter_package_manager" "$adapter_framework"
  done
done

parallel_vinext_target="$adapter_root/Parallel Next and Vinext Scripts"
mkdir -p "$parallel_vinext_target"
printf '%s\n' \
  '{"private":true,"scripts":{"dev":"next dev","dev:vinext":"vinext dev"},"dependencies":{"next":"^16.0.0","vinext":"^0.0.0"},"devDependencies":{"vite":"^8.0.0"}}' \
  > "$parallel_vinext_target/package.json"
: > "$parallel_vinext_target/package-lock.json"
"$repository_dir/integration/scripts/install" --plan --json \
  "$parallel_vinext_target" | jq -e '
    (.manifestStatus == "configurationRequired") and
    (.inference.framework == "vinext") and
    (.inference.reason | contains("not a tested direct framework command"))
  ' >/dev/null

conflict_target="$adapter_root/Conflicting Package Managers"
mkdir -p "$conflict_target"
printf '%s\n' \
  '{"private":true,"packageManager":"pnpm@10.0.0","scripts":{"dev":"vite"},"devDependencies":{"vite":"^7.0.0"}}' \
  > "$conflict_target/package.json"
: > "$conflict_target/yarn.lock"
"$repository_dir/integration/scripts/install" --plan --json "$conflict_target" |
  jq -e '
    (.manifestStatus == "configurationRequired") and
    (.inference.command == null) and
    (.inference.reason | contains("conflicting package-manager signals"))
  ' >/dev/null

indirect_target="$adapter_root/Indirect Vite Script"
mkdir -p "$indirect_target"
printf '%s\n' \
  '{"private":true,"scripts":{"dev":"concurrently \"vite\" \"node api.js\""},"devDependencies":{"vite":"^7.0.0"}}' \
  > "$indirect_target/package.json"
: > "$indirect_target/package-lock.json"
"$repository_dir/integration/scripts/install" --plan --json "$indirect_target" |
  jq -e '
    (.manifestStatus == "configurationRequired") and
    (.inference.framework == "vite") and
    (.inference.reason | contains("not a tested direct framework command"))
  ' >/dev/null

if "$repository_dir/integration/scripts/install" --plan "$root_manifest_target" \
  >"$test_root/root-manifest.out" 2>&1; then
  echo "Error: installer accepted a root-level manifest." >&2
  exit 1
fi
grep -Fq "manifest must live at enmanner/enmanner.json" \
  "$test_root/root-manifest.out"

if "$repository_dir/integration/scripts/install" --plan \
  "$source_collision_target" >"$test_root/source-collision.out" 2>&1; then
  echo "Error: installer accepted overlapping source and configuration paths." >&2
  exit 1
fi
grep -Fq "source code and project-owned configuration must be distinct" \
  "$test_root/source-collision.out"

if "$repository_dir/integration/scripts/install" --plan \
  "$checkout_collision_target" >"$test_root/checkout-collision.out" 2>&1; then
  echo "Error: installer accepted a Git checkout at enmanner/." >&2
  exit 1
fi
grep -Fq "enmanner/ configuration path is a Git checkout" \
  "$test_root/checkout-collision.out"

plan="$(
  "$repository_dir/integration/scripts/install" \
    --plan --json "$vite_target"
)"
printf '%s\n' "$plan" | jq -e '
  (.schemaVersion == 1) and
  (.action == "plan") and
  (.manifestStatus == "inferred") and
  (.installed == false) and
  (.completionStatus == "iconRequired") and
  (.build.blockedBy == "iconRequired") and
  (.git.dirty | type == "boolean") and
  (.git.ahead | type == "number") and
  (.git.aheadBehindSource == "localRemoteTrackingRefs") and
  (.git.networkAccessed == false) and
  (.inference.signalsExamined | length > 0) and
  (.inference.preferredPortDerivation.identifier == "local.enmanner.vite-project") and
  (.nameCandidates | length >= 1) and
  ([.requiredInstructions[].path] | index(".enmanner/instructions/integration.md")) and
  ([.nextActionCommands[].id] | index("buildDevelopmentApp")) and
  ([.nextActionCommands[].id] | index("testDevelopmentApp")) and
  ([.nextActionCommands[].id] | index("buildApp")) and
  ([.nextActionCommands[].id] | index("testApp")) and
  (.fileOperations | type == "array") and
  ([.fileOperations[].path] | index("enmanner/")) and
  ([.fileOperations[].path] | index("enmanner/enmanner.json"))
' >/dev/null
test ! -e "$vite_target/.enmanner"
test ! -e "$vite_target/enmanner"

service_plan="$(
  "$repository_dir/integration/scripts/install" \
    --plan --json "$service_workspace/Frontend"
)"
service_workspace_physical="$(cd "$service_workspace" && /bin/pwd -P)"
printf '%s\n' "$service_plan" | jq -e \
  --arg workspace "$service_workspace_physical" '
    (.targetScope.reviewRequired == true) and
    (.targetScope.acknowledged == false) and
    (.targetScope.candidateWorkspaceRoot == $workspace) and
    (.installationApplicable == false) and
    (.manifestStatus == "configurationRequired") and
    ([.unresolvedChecks[].id] | index("integrationRoot")) and
    ([.warnings[]] | any(contains("Possible service-subproject target")))
  ' >/dev/null
if "$repository_dir/integration/scripts/install" --no-build \
  "$service_workspace/Frontend" >"$test_root/service-install.out" 2>&1; then
  echo "Error: installer accepted an unacknowledged service subproject." >&2
  exit 1
fi
grep -Fq -- "--allow-subproject" "$test_root/service-install.out"
"$repository_dir/integration/scripts/install" --allow-subproject \
  --plan --json "$service_workspace/Frontend" | jq -e '
    (.targetScope.reviewRequired == true) and
    (.targetScope.acknowledged == true) and
    (.installationApplicable == true) and
    (.manifestStatus == "inferred") and
    (.unresolvedChecks | length == 0)
  ' >/dev/null

workspace_plan="$(
  "$repository_dir/integration/scripts/install" \
    --plan --json "$workspace_target"
)"
printf '%s\n' "$workspace_plan" | jq -e '
  (.git.classification == "workspace-with-nested-repositories") and
  (.git.nestedRepositories == 2) and
  (.git.projectRootConfigurationTracked == false) and
  (.git.requiresUnversionedAcknowledgement == true) and
  (.recommendedIntegrationRoot == .target) and
  (.rootSelectionConfidence == "high") and
  (.configurationDurability == "unversioned") and
  (.canProceedWithoutProductDecision == true) and
  ([.warnings[]] | any(contains("workspace root is not versioned")))
' >/dev/null
if "$repository_dir/integration/scripts/install" --no-build \
  "$workspace_target" >"$test_root/workspace-install.out" 2>&1; then
  echo "Error: installer accepted an unacknowledged nested-repository workspace." >&2
  exit 1
fi
grep -Fq -- "--allow-unversioned" "$test_root/workspace-install.out"

"$repository_dir/integration/scripts/install" --plan --json "$express_target" |
  jq -e '
    (.manifestStatus == "inferred") and
    ([.detectedStacks[]] | index("Express")) and
    (.inference.framework == "express") and
    (.inference.runtimeVerificationRequired == true) and
    ([.inference.staticEvidence[].check] | index("dynamicPort")) and
    ([.inference.staticEvidence[].check] | index("loopbackBinding")) and
    ([.inference.staticEvidence[].check] | index("foregroundEntryPoint")) and
    (.unresolvedChecks | length == 0)
  ' >/dev/null
"$repository_dir/integration/scripts/install" \
  --upstream-url "https://example.test/Enmanner.git" \
  --no-build --json "$express_target" >/dev/null
jq -e '
  (.application.environment.PORT == "${self.endpoints.http.port}") and
  (.application.environment.HOST == "127.0.0.1")
' "$express_target/enmanner/enmanner.json" >/dev/null
jq -e '
  (.upstreamURL == "https://example.test/Enmanner.git") and
  (.provenanceConfidence == "explicit") and
  (.sourceCheckoutURL | type == "string")
' "$express_target/.enmanner/INSTALLATION.json" >/dev/null

"$repository_dir/integration/scripts/install" --plan --json "$cache_target" |
  jq -e '
    (.installationState == "cacheOnly") and
    .installationApplicable and
    (.safeRecovery.action == "removeGeneratedCacheAndInstall") and
    .safeRecovery.automatic and
    ([.fileOperations[].action] | index("removeGeneratedCache"))
  ' >/dev/null
"$repository_dir/integration/scripts/install" \
  --no-build --json "$cache_target" |
  jq -e '.installed and (.installationState == "cacheOnly")' >/dev/null
test -f "$cache_target/.enmanner/INSTALLATION.json"
git -C "$cache_target" init -q
git -C "$cache_target" add \
  package.json package-lock.json .enmanner enmanner AGENTS.md .gitignore
"$cache_target/.enmanner/scripts/doctor" --json |
  jq -e '
    .doctor.milestones.repositoryReady and
    (.doctor.workspace.status == "tracked") and
    .doctor.workspace.frameworkTracked and
    .doctor.workspace.durablePathsTracked
  ' >/dev/null
"$cache_target/.enmanner/scripts/doctor" --next \
  >"$test_root/next-brief.md"
test "$(head -n 1 "$test_root/next-brief.md")" = "# Enmanner next steps"
grep -Fq "# Enmanner next steps" "$test_root/next-brief.md"
grep -Fq "**Runtime:** one Vite service" "$test_root/next-brief.md"
grep -Fq "## Relevant guidance" "$test_root/next-brief.md"

"$repository_dir/integration/scripts/install" --plan --json \
  "$incomplete_target" |
  jq -e '
    (.installationState == "incomplete") and
    (.installationApplicable == false) and
    (.safeRecovery.action == "replaceIncomplete")
  ' >/dev/null
if "$repository_dir/integration/scripts/install" --no-build \
  "$incomplete_target" >"$test_root/incomplete-install.out" 2>&1; then
  echo "Error: installer implicitly replaced an incomplete framework." >&2
  exit 1
fi
grep -Fq -- "--replace-incomplete" "$test_root/incomplete-install.out"
incomplete_result="$(
  "$repository_dir/integration/scripts/install" \
    --replace-incomplete --allow-unversioned \
    --no-build --json "$incomplete_target"
)"
printf '%s\n' "$incomplete_result" | jq -e '
  .installed and
  (.installationState == "incomplete") and
  (.recoveryBackup | type == "string")
' >/dev/null
incomplete_backup="$(
  printf '%s\n' "$incomplete_result" | jq -r '.recoveryBackup'
)"
test -f "$incomplete_backup/VERSION"
test -f "$incomplete_target/.enmanner/INSTALLATION.json"
jq -e '.unversionedAcknowledged == true' \
  "$incomplete_target/.enmanner/INSTALLATION.json" >/dev/null
"$incomplete_target/.enmanner/scripts/doctor" --json |
  jq -e '
    .doctor.milestones.repositoryReady and
    (.doctor.workspace.status == "acknowledgedUnversioned")
  ' >/dev/null

"$repository_dir/integration/scripts/install" --plan --json "$legacy_target" |
  jq -e '
    (.installationState == "legacyWithoutReceipt") and
    (.safeRecovery.action == "replaceIncomplete")
  ' >/dev/null
"$repository_dir/integration/scripts/install" --plan --json "$damaged_target" |
  jq -e '
    (.installationState == "damaged") and
    (.safeRecovery.action == "replaceIncomplete")
  ' >/dev/null

vite_result="$(
  "$repository_dir/integration/scripts/install" \
    --no-build --json "$vite_target"
)"
printf '%s\n' "$vite_result" | jq -e '
  .installed and
  (.installationState == "notInstalled") and
  (.manifestStatus == "inferred") and
  (.built == false)
' >/dev/null
"$repository_dir/integration/scripts/install" --plan --json "$vite_target" |
  jq -e '
    (.installationState == "installed") and
    (.installationApplicable == false) and
    (.safeRecovery.action == "repair") and
    ([.fileOperations[] | select(.willWrite == true)] | length == 0)
  ' >/dev/null
jq -e '
  (.version == 3) and
  (.window | has("mode") | not) and
  (.application.preferredPort >= 42000) and
  (.application.preferredPort < 48000)
' "$vite_target/enmanner/enmanner.json" >/dev/null
test ! -e "$vite_target/enmanner.json"

if "$vite_target/.enmanner/scripts/build-app" \
  >"$test_root/missing-icon.out" 2>&1; then
  echo "Error: build-app accepted a manifest without an icon." >&2
  exit 1
fi
grep -Fq "does not build placeholder launchers" "$test_root/missing-icon.out"
if "$vite_target/.enmanner/scripts/build-app" --json \
  >"$test_root/missing-icon.json"; then
  echo "Error: JSON build-app accepted a manifest without an icon." >&2
  exit 1
fi
jq -e '
  (.valid == false) and
  (.error.code == "buildFailed") and
  (.error.message | contains("no app icon is configured"))
' "$test_root/missing-icon.json" >/dev/null
test ! -e "$vite_target/Vite Project.app"

"$vite_target/.enmanner/scripts/build-app" --development --json \
  >"$test_root/development-build.json"
jq -e '
  .valid and
  (.buildKind == "development") and
  (.bundleIdentifier == "local.enmanner.vite-project.development") and
  (.icon.source == "framework-generated-development-icon") and
  (.icon.packaging == "developmentIcns") and
  .icon.verified and
  .signing.verified and
  (.appPath | endswith("/Vite Project Development.app"))
' "$test_root/development-build.json" >/dev/null
development_app="$vite_target/Vite Project Development.app"
test -x "$development_app/Contents/MacOS/EnmannerLauncher"
test "$(
  /usr/bin/plutil -extract buildKind raw \
    "$development_app/Contents/Resources/EnmannerOwnership.plist"
)" = "development"
test "$(
  /usr/bin/plutil -extract manifestBundleIdentifier raw \
    "$development_app/Contents/Resources/EnmannerOwnership.plist"
)" = "local.enmanner.vite-project"
"$vite_target/.enmanner/scripts/doctor" --json |
  jq -e '
    (.doctor.complete == false) and
    (.doctor.integrationStatus == "iconRequired") and
    .doctor.developmentAppExists and
    .doctor.developmentAppOwnershipMatches and
    .doctor.completionEvidence.developmentAppBuilt and
    (.doctor.completionEvidence.developmentNativeLaunchVerified == false) and
    (.doctor.completionEvidence.nativeLaunchVerified == false)
  ' >/dev/null

generic_result="$(
  "$repository_dir/integration/scripts/install" \
    --name "Generic Nice" \
    --identifier "com.example.generic-nice" \
    --json "$generic_target"
)"
printf '%s\n' "$generic_result" | jq -e '
  .installed and
  .configurationRequired and
  (.built == false) and
  (.completionStatus == "configurationRequired") and
  (.build.blockedBy == "configurationRequired") and
  (.unresolvedChecks | length == 3) and
  ([.unresolvedChecks[].inspect[]] | index("package.json")) and
  ([.otherAgentInstructions[]] | index("CLAUDE.md")) and
  (.warnings | length == 1) and
  ([.fileOperations[].path] | index("enmanner/enmanner.json.example")) and
  ([.performedWrites[]] | index("enmanner/enmanner.json.example"))
' >/dev/null
test ! -e "$generic_target/enmanner/enmanner.json"
jq -e '
  (.name == "Generic Nice") and
  (.identifier == "com.example.generic-nice") and
  (.application.command == ["npm", "run", "start"]) and
  (.application.preferredPort >= 42000) and
  (.application.preferredPort < 48000)
' "$generic_target/enmanner/enmanner.json.example" >/dev/null
grep -Fqx '# Generic project instructions' "$generic_target/CLAUDE.md"

cp "$generic_target/enmanner/enmanner.json.example" \
  "$generic_target/enmanner/enmanner.json"
/usr/bin/plutil -remove application.readiness \
  "$generic_target/enmanner/enmanner.json"
if "$generic_target/.enmanner/scripts/validate" --json \
  >"$test_root/manifest-error.json"; then
  echo "Error: validator accepted a manifest missing application.readiness." >&2
  exit 1
fi
jq -e '
  (.valid == false) and
  (.error.code == "manifestInvalid") and
  (.error.message | contains("application.readiness"))
' "$test_root/manifest-error.json" >/dev/null

mkdir -p "$vite_target/enmanner/icon"
cp "$repository_dir/examples/vite-example/enmanner/icon/icon-background.png" \
  "$vite_target/enmanner/icon/icon-background.png"
cp "$repository_dir/examples/vite-example/enmanner/icon/icon-foreground.png" \
  "$vite_target/enmanner/icon/icon-foreground.png"
/usr/bin/xcrun swift - \
  "$vite_target/enmanner/icon/icon-background.png" \
  "$vite_target/enmanner/icon/rgba-background.png" <<'SWIFT'
import CoreGraphics
import Foundation
import ImageIO

let inputURL = URL(fileURLWithPath: CommandLine.arguments[1]) as CFURL
let outputURL = URL(fileURLWithPath: CommandLine.arguments[2]) as CFURL
guard let source = CGImageSourceCreateWithURL(inputURL, nil),
      let image = CGImageSourceCreateImageAtIndex(source, 0, nil),
      let destination = CGImageDestinationCreateWithURL(
        outputURL,
        "public.png" as CFString,
        1,
        nil
      ) else {
    fatalError("Could not rewrite the background PNG.")
}
let width = image.width
let height = image.height
guard let context = CGContext(
    data: nil,
    width: width,
    height: height,
    bitsPerComponent: 8,
    bytesPerRow: width * 4,
    space: CGColorSpaceCreateDeviceRGB(),
    bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
) else {
    fatalError("Could not create an RGBA image.")
}
context.draw(image, in: CGRect(x: 0, y: 0, width: width, height: height))
guard let rgbaImage = context.makeImage() else {
