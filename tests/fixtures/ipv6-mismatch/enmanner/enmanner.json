{
  "version": 3,
  "name": "IPv6 Mismatch",
  "identifier": "local.enmanner.ipv6-mismatch",
  "application": {
    "command": ["node", "server.mjs"],
    "environment": {
      "PORT": "${self.endpoints.http.port}"
    },
    "readiness": {
      "path": "/",
      "timeoutSeconds": 10
    }
  },
  "window": {
    "width": 800,
    "height": 600,
    "resizable": true
  }
}
