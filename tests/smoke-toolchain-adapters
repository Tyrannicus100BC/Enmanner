#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository_dir="$(cd "$script_dir/.." && pwd)"
test_root="$(mktemp -d "${TMPDIR:-/tmp}/Enmanner Adapter Smoke.XXXXXX")"
cleanup() {
  rm -rf "$test_root"
}
trap cleanup EXIT

next_target="$test_root/Next Project"
/usr/bin/ditto "$repository_dir/tests/fixtures/next-app" "$next_target"
npm ci --prefix "$next_target" --audit=false --fund=false

install_result="$(
  "$repository_dir/integration/scripts/install" \
    --no-build --json "$next_target"
)"
printf '%s\n' "$install_result" | jq -e '
  (.manifestStatus == "inferred") and
  (.inference.packageManager == "npm") and
  (.inference.framework == "next") and
  (.inference.command == [
    "npm", "run", "dev", "--",
    "--hostname", "127.0.0.1",
    "--port", "${self.endpoints.http.port}"
  ])
' >/dev/null

"$next_target/.enmanner/scripts/validate" --runtime --json |
  jq -e '
    .valid and
    .runtime.startup.readinessPassed and
    .runtime.shutdown.supervisorExited and
    .runtime.shutdown.processGroupsStopped and
    .runtime.shutdown.applicationEndpointUnavailable and
    .runtime.shutdown.ownedPortsReleased
  ' >/dev/null

echo "✓ Next.js npm adapter passed real startup and shutdown validation"

vinext_target="$test_root/Vinext Project"
/usr/bin/ditto "$repository_dir/tests/fixtures/vinext-app" "$vinext_target"
npm ci --prefix "$vinext_target" --audit=false --fund=false

vinext_install_result="$(
  "$repository_dir/integration/scripts/install" \
    --no-build --json "$vinext_target"
)"
printf '%s\n' "$vinext_install_result" | jq -e '
  (.manifestStatus == "inferred") and
  (.inference.packageManager == "npm") and
  (.inference.framework == "vinext") and
  (.inference.command == [
    "npm", "run", "dev", "--",
    "--hostname", "127.0.0.1",
    "--port", "${self.endpoints.http.port}"
  ])
' >/dev/null

"$vinext_target/.enmanner/scripts/validate" --runtime --json |
  jq -e '
    .valid and
    .runtime.startup.readinessPassed and
    .runtime.shutdown.supervisorExited and
    .runtime.shutdown.processGroupsStopped and
    .runtime.shutdown.applicationEndpointUnavailable and
    .runtime.shutdown.ownedPortsReleased
  ' >/dev/null

echo "✓ Vinext npm adapter passed real startup and shutdown validation"
