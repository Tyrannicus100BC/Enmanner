#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository_dir="$(cd "$script_dir/.." && pwd)"
example_dir="${ENMANNER_SMOKE_EXAMPLE_DIR:-$repository_dir/examples/vite-example}"
runtime_events="$(mktemp "${TMPDIR:-/tmp}/enmanner-runtime-events.XXXXXX")"
trap 'rm -f "$runtime_events"' EXIT

if [[ ! -d "$example_dir/node_modules" ]]; then
  echo "Installing example dependencies…"
  npm ci --prefix "$example_dir"
fi

"$example_dir/.enmanner/scripts/validate" --runtime --json-lines \
  >"$runtime_events"
jq -s -e '
  ([.[].event] | index("componentStarted")) and
  ([.[].event] | index("componentOutput")) and
  ([.[].event] | index("probePassed")) and
  ([.[].event] | index("soakStarted")) and
  ([.[].event] | index("soakPassed")) and
  ([.[].event] | index("componentExited")) and
  (map(select(.event == "complete"))[0].report.runtime |
    .readinessPassed and
    .soakPassed and
    (.soakSeconds == 5) and
    .portReleased and
    (.ownedPorts | length == 1) and
    (.observedPorts | length == 0))
' "$runtime_events" >/dev/null
"$example_dir/.enmanner/scripts/build-app" --development --json |
  jq -e '
    .valid and
    (.buildKind == "development") and
    (.bundleIdentifier | endswith(".development")) and
    (.icon.packaging == "developmentIcns")
  ' >/dev/null
"$example_dir/.enmanner/scripts/test-app" --development --json |
  jq -e '
    .valid and
    (.buildKind == "development") and
    .readinessPassed and
    .quitCleanly and
    .readinessUnavailable and
    .portReleased
  ' >/dev/null
"$example_dir/.enmanner/scripts/preview-icon" --json |
  jq -e '
    .valid and
    (.appearances | length == 6) and
    ([.appearances[].name] | index("ClearLight")) and
    ([.appearances[].name] | index("TintedDark")) and
    (.contactSheet | endswith("contact-sheet.png")) and
    (.metrics.foreground.alphaCoverage > 0) and
    (.metrics.background.cornersOpaque == true)
  ' >/dev/null
"$example_dir/.enmanner/scripts/build-app"

app_path="$example_dir/Enmanner Vite Example.app"
if [[ ! -x "$app_path/Contents/MacOS/EnmannerLauncher" ]]; then
  echo "Error: generated launcher is missing or not executable." >&2
  exit 1
fi
if [[ ! -f "$app_path/Contents/Resources/Assets.car" ]]; then
  echo "Error: generated launcher is missing its modern icon catalog." >&2
  exit 1
fi
ownership_marker="$app_path/Contents/Resources/EnmannerOwnership.plist"
ownership_identifier="$(
  /usr/bin/plutil -extract bundleIdentifier raw "$ownership_marker"
)"
if [[ "$ownership_identifier" != "local.enmanner.vite-example" ]]; then
  echo "Error: generated launcher has no matching Enmanner ownership marker." >&2
  exit 1
fi
folder_usage_description="This folder contains your project, which the app needs to run."
folder_usage_keys=(
  NSDesktopFolderUsageDescription
  NSDocumentsFolderUsageDescription
  NSDownloadsFolderUsageDescription
  NSNetworkVolumesUsageDescription
  NSRemovableVolumesUsageDescription
)
for usage_key in "${folder_usage_keys[@]}"; do
  actual_description="$(
    /usr/bin/plutil -extract "$usage_key" raw "$app_path/Contents/Info.plist"
  )"
  if [[ "$actual_description" != "$folder_usage_description" ]]; then
    echo "Error: generated launcher has an invalid $usage_key." >&2
    exit 1
  fi
done
/usr/bin/codesign --verify --deep --strict "$app_path"
"$example_dir/.enmanner/scripts/test-app" --json |
  jq -e '
    .valid and
    (.buildKind == "final") and
    .readinessPassed and
    .quitCleanly and
    .readinessUnavailable and
    .portReleased
  ' >/dev/null
"$example_dir/.enmanner/scripts/doctor" --json |
  jq -e '
    .doctor.complete and
    .doctor.completionEvidence.developmentNativeLaunchVerified and
    .doctor.completionEvidence.nativeLaunchVerified and
    (.doctor.currentStatus.configuration == "valid") and
    (.doctor.currentStatus.integration == "complete")
  ' >/dev/null
if find "$app_path" \( -name node_modules -o -name .git -o -name src -o -name enmanner.json \) |
  grep -q .; then
  echo "Error: generated app contains project source or dependencies." >&2
  exit 1
fi
if [[ -e "$example_dir/.enmanner/framework/Tests" ||
  -e "$example_dir/.enmanner/scripts/install" ]]; then
  echo "Error: installed example contains development-only framework files." >&2
  exit 1
fi

echo "✓ Vite smoke test passed and the app bundle contains only launcher assets"
