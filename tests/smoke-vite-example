#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository_dir="$(cd "$script_dir/.." && pwd)"
source_example_dir="${ENMANNER_SMOKE_EXAMPLE_DIR:-$repository_dir/examples/vite-example}"
smoke_workspace="$(mktemp -d "${TMPDIR:-/tmp}/enmanner-vite-smoke.XXXXXX")"
example_dir="$smoke_workspace/Vite Example With Spaces"
runtime_events="$(mktemp "${TMPDIR:-/tmp}/enmanner-runtime-events.XXXXXX")"
managed_launcher_pid=""
managed_bundle_identifier="local.enmanner.vite-example.development"
managed_log=""
managed_private_status=""
managed_status_error=""
cleanup() {
  if [[ -n "$managed_launcher_pid" ]] &&
    kill -0 "$managed_launcher_pid" 2>/dev/null; then
    /usr/bin/osascript - "$managed_bundle_identifier" <<'APPLESCRIPT' >/dev/null 2>&1 || true
on run arguments
  tell application id (item 1 of arguments) to quit
end run
APPLESCRIPT
    for _ in {1..100}; do
      kill -0 "$managed_launcher_pid" 2>/dev/null || break
      sleep 0.05
    done
    kill -KILL "$managed_launcher_pid" 2>/dev/null || true
  fi
  rm -f "$runtime_events"
  [[ -z "$managed_log" ]] || rm -f "$managed_log"
  [[ -z "$managed_private_status" ]] || rm -f "$managed_private_status"
  [[ -z "$managed_status_error" ]] || rm -f "$managed_status_error"
  rm -rf "$smoke_workspace"
}
trap cleanup EXIT

# Exercise the current framework source, not the example's intentionally
# receipt-pinned installed copy. The isolated project also keeps generated app
# bundles and test receipts out of the repository and verifies paths with spaces.
/usr/bin/ditto --noqtn "$source_example_dir" "$example_dir"
rm -rf "$example_dir/.enmanner"
"$repository_dir/integration/scripts/install" "$example_dir" >/dev/null

if [[ ! -d "$example_dir/node_modules" ]]; then
  echo "Installing example dependencies…"
  npm ci --prefix "$example_dir"
fi

"$example_dir/.enmanner/scripts/validate" --runtime --json-lines \
  >"$runtime_events"
jq -s -e '
  ([.[].event] | index("componentStarted")) and
  ([.[].event] | index("componentOutput")) and
  ([.[].event] | index("probePassed")) and
  ([.[].event] | index("soakStarted")) and
  ([.[].event] | index("soakPassed")) and
  ([.[].event] | index("componentExited")) and
  (map(select(.event == "complete"))[0].report.runtime |
    .startup.readinessPassed and
    .startup.soakPassed and
    (.startup.soakSeconds == 5) and
    .shutdown.ownedPortsReleased and
    (.ownedPorts | length == 1) and
    (.observedPorts | length == 0))
' "$runtime_events" >/dev/null
"$example_dir/.enmanner/scripts/build-app" --development --json |
  jq -e '
    .valid and
    (.buildKind == "development") and
    (.bundleIdentifier | endswith(".development")) and
    (.icon.packaging == "developmentIcns")
  ' >/dev/null

development_launcher="$example_dir/Enmanner Vite Example Development.app/Contents/MacOS/EnmannerLauncher"
managed_log="$(mktemp "${TMPDIR:-/tmp}/enmanner-managed-runtime.XXXXXX")"
managed_private_status="$(mktemp "${TMPDIR:-/tmp}/enmanner-managed-status.XXXXXX")"
managed_status_error="$(mktemp "${TMPDIR:-/tmp}/enmanner-managed-error.XXXXXX")"
rm -f "$managed_private_status"
/usr/bin/env -i \
  HOME="${HOME:-}" \
  USER="${USER:-}" \
  LOGNAME="${LOGNAME:-${USER:-}}" \
  TMPDIR="${TMPDIR:-/tmp}" \
  LANG="${LANG:-en_US.UTF-8}" \
  PATH="/usr/bin:/bin:/usr/sbin:/sbin" \
  ENMANNER_TEST_STATUS_FILE="$managed_private_status" \
  ENMANNER_TEST_ENABLE_RUNTIME_CONTROL=1 \
  ENMANNER_TEST_SUPPRESS_BROWSER=1 \
  "$development_launcher" \
  >"$managed_log" 2>&1 &
managed_launcher_pid="$!"
managed_status=""
for _ in {1..300}; do
  if managed_status="$(
    "$example_dir/.enmanner/scripts/runtime-status" --json 2>"$managed_status_error"
  )" && [[ "$(
    printf '%s' "$managed_status" |
      /usr/bin/plutil -extract state raw -o - - 2>/dev/null
  )" == "ready" ]]; then
    break
  fi
  if ! kill -0 "$managed_launcher_pid" 2>/dev/null; then
    echo "Error: managed runtime exited before status became ready." >&2
    tail -n 30 "$managed_log" >&2
    exit 1
  fi
  sleep 0.1
done
if [[ -z "$managed_status" ]] || [[ "$(
  printf '%s' "$managed_status" |
    /usr/bin/plutil -extract state raw -o - - 2>/dev/null || true
)" != "ready" ]]; then
  echo "Error: managed runtime did not publish ready status." >&2
  cat "$managed_status_error" >&2
  tail -n 30 "$managed_log" >&2
  exit 1
fi
initial_generation="$(
  printf '%s' "$managed_status" |
    /usr/bin/plutil -extract runtimeGeneration raw -o - -
)"
initial_url="$(
  printf '%s' "$managed_status" |
    /usr/bin/plutil -extract applicationURL raw -o - -
)"
if [[ "$initial_generation" != "1" || -z "$initial_url" ]]; then
  echo "Error: managed runtime status did not identify its first ready generation." >&2
  exit 1
fi

wrong_project="$smoke_workspace/Wrong Project"
mkdir -p "$wrong_project/.enmanner/scripts" "$wrong_project/enmanner"
cp "$example_dir/.enmanner/scripts/runtime-status" \
  "$wrong_project/.enmanner/scripts/runtime-status"
cp "$example_dir/enmanner/enmanner.json" \
  "$wrong_project/enmanner/enmanner.json"
if "$wrong_project/.enmanner/scripts/runtime-status" --json >/dev/null 2>&1; then
  echo "Error: runtime status accepted a different project with the same identifier." >&2
  exit 1
fi

/usr/bin/sed -i '' \
  's/^VITE_GREETING=.*/VITE_GREETING=Externally reloaded by Enmanner./' \
  "$example_dir/.env"
updated_status=""
for _ in {1..600}; do
  updated_status="$(
    "$example_dir/.enmanner/scripts/runtime-status" --json 2>/dev/null || true
  )"
  updated_generation="$(
    printf '%s' "$updated_status" |
      /usr/bin/plutil -extract runtimeGeneration raw -o - - 2>/dev/null || true
  )"
  updated_state="$(
    printf '%s' "$updated_status" |
      /usr/bin/plutil -extract state raw -o - - 2>/dev/null || true
  )"
  if [[ "$updated_state" == "ready" && "$updated_generation" == "2" ]]; then
    break
  fi
  sleep 0.1
done
updated_url="$(
  printf '%s' "$updated_status" |
    /usr/bin/plutil -extract applicationURL raw -o - -
)"
configuration_stale="$(
  printf '%s' "$updated_status" |
    /usr/bin/plutil -extract configuration.changedSinceLaunch raw -o - -
)"
if [[ "$updated_url" != "$initial_url" || "$configuration_stale" != "false" ]]; then
  echo "Error: external configuration restart changed endpoints or remained stale." >&2
  exit 1
fi
if ! /usr/bin/curl --silent --show-error --fail \
  "${updated_url%/}/src/main.js" |
  grep -Fq "Externally reloaded by Enmanner."; then
  echo "Error: managed endpoint did not expose externally edited configuration." >&2
  exit 1
fi

manual_status="$(
  "$example_dir/.enmanner/scripts/runtime-restart" --wait --json
)"
manual_generation="$(
  printf '%s' "$manual_status" |
    /usr/bin/plutil -extract runtimeGeneration raw -o - -
)"
manual_url="$(
  printf '%s' "$manual_status" |
    /usr/bin/plutil -extract applicationURL raw -o - -
)"
if [[ "$manual_generation" != "3" || "$manual_url" != "$initial_url" ]]; then
  echo "Error: supported runtime restart did not preserve the managed endpoint." >&2
  exit 1
fi

valid_configuration="$smoke_workspace/valid.env"
cp "$example_dir/.env" "$valid_configuration"
printf '\nVITE_GREETING=duplicate\n' >> "$example_dir/.env"
invalid_status=""
for _ in {1..300}; do
  invalid_status="$(
    "$example_dir/.enmanner/scripts/runtime-status" --json 2>/dev/null || true
  )"
  invalid_state="$(
    printf '%s' "$invalid_status" |
      /usr/bin/plutil -extract state raw -o - - 2>/dev/null || true
  )"
  [[ "$invalid_state" == "waitingForConfiguration" ]] && break
  sleep 0.1
done
invalid_stale="$(
  printf '%s' "$invalid_status" |
    /usr/bin/plutil -extract configuration.changedSinceLaunch raw -o - -
)"
if [[ "$invalid_state" != "waitingForConfiguration" ||
  "$invalid_stale" != "true" ]]; then
  echo "Error: invalid external configuration did not stop the stale runtime." >&2
  exit 1
fi
if /usr/bin/curl --silent --max-time 0.5 "$initial_url" >/dev/null 2>&1; then
  echo "Error: managed endpoint remained available with invalid configuration." >&2
  exit 1
fi

cp "$valid_configuration" "$example_dir/.env"
recovered_status=""
for _ in {1..600}; do
  recovered_status="$(
    "$example_dir/.enmanner/scripts/runtime-status" --json 2>/dev/null || true
  )"
  recovered_generation="$(
    printf '%s' "$recovered_status" |
      /usr/bin/plutil -extract runtimeGeneration raw -o - - 2>/dev/null || true
  )"
  recovered_state="$(
    printf '%s' "$recovered_status" |
      /usr/bin/plutil -extract state raw -o - - 2>/dev/null || true
  )"
  if [[ "$recovered_state" == "ready" &&
    "$recovered_generation" == "4" ]]; then
    break
  fi
  sleep 0.1
done
recovered_url="$(
  printf '%s' "$recovered_status" |
    /usr/bin/plutil -extract applicationURL raw -o - -
)"
if [[ "$recovered_state" != "ready" || "$recovered_url" != "$initial_url" ]]; then
  echo "Error: corrected external configuration did not recover the runtime." >&2
  exit 1
fi

/usr/bin/osascript - "$managed_bundle_identifier" <<'APPLESCRIPT' >/dev/null
on run arguments
  tell application id (item 1 of arguments) to quit
end run
APPLESCRIPT
for _ in {1..100}; do
  kill -0 "$managed_launcher_pid" 2>/dev/null || break
  sleep 0.1
done
if kill -0 "$managed_launcher_pid" 2>/dev/null; then
  echo "Error: managed runtime did not quit cleanly after reload testing." >&2
  exit 1
fi
wait "$managed_launcher_pid" || true
managed_launcher_pid=""
rm -f "$managed_log"
managed_log=""
rm -f "$managed_private_status"
managed_private_status=""
rm -f "$managed_status_error"
managed_status_error=""

"$example_dir/.enmanner/scripts/test-app" --development --json |
  jq -e '
    .valid and
    (.buildKind == "development") and
    .startup.readinessPassed and
    (.startup.componentProcessIdentifiers | length == 1) and
    .shutdown.quitCleanly and
    .shutdown.applicationEndpointUnavailable and
    .shutdown.ownedPortsReleased
  ' >/dev/null
"$example_dir/.enmanner/scripts/preview-icon" --json |
  jq -e '
    .valid and
    (.appearances | length == 6) and
    ([.appearances[].name] | index("ClearLight")) and
    ([.appearances[].name] | index("TintedDark")) and
    (.contactSheet | endswith("contact-sheet.png")) and
    (.metrics.foreground.alphaCoverage > 0) and
    (.metrics.background.cornersOpaque == true)
  ' >/dev/null
"$example_dir/.enmanner/scripts/build-app"

app_path="$example_dir/Enmanner Vite Example.app"
if [[ ! -x "$app_path/Contents/MacOS/EnmannerLauncher" ]]; then
  echo "Error: generated launcher is missing or not executable." >&2
  exit 1
fi
if [[ ! -f "$app_path/Contents/Resources/Assets.car" ]]; then
  echo "Error: generated launcher is missing its modern icon catalog." >&2
  exit 1
fi
ownership_marker="$app_path/Contents/Resources/EnmannerOwnership.plist"
ownership_identifier="$(
  /usr/bin/plutil -extract bundleIdentifier raw "$ownership_marker"
)"
if [[ "$ownership_identifier" != "local.enmanner.vite-example" ]]; then
  echo "Error: generated launcher has no matching Enmanner ownership marker." >&2
  exit 1
fi
folder_usage_description="This folder contains your project, which the app needs to run."
folder_usage_keys=(
  NSDesktopFolderUsageDescription
  NSDocumentsFolderUsageDescription
  NSDownloadsFolderUsageDescription
  NSNetworkVolumesUsageDescription
  NSRemovableVolumesUsageDescription
)
for usage_key in "${folder_usage_keys[@]}"; do
  actual_description="$(
    /usr/bin/plutil -extract "$usage_key" raw "$app_path/Contents/Info.plist"
  )"
  if [[ "$actual_description" != "$folder_usage_description" ]]; then
    echo "Error: generated launcher has an invalid $usage_key." >&2
    exit 1
  fi
done
/usr/bin/codesign --verify --deep --strict "$app_path"
"$example_dir/.enmanner/scripts/test-app" --json |
  jq -e '
    .valid and
    (.buildKind == "final") and
    .startup.readinessPassed and
    (.startup.componentProcessIdentifiers | length == 1) and
    .shutdown.quitCleanly and
    .shutdown.applicationEndpointUnavailable and
    .shutdown.ownedPortsReleased
  ' >/dev/null
"$example_dir/.enmanner/scripts/upgrade" \
  --apply --from "$repository_dir" --verify --json |
  jq -e '
    .applied and
    .verified and
    (.fromVersion == "0.6.1") and
    (.toVersion == "0.6.1") and
    (.verification.runtime.valid == true) and
    (.verification.build.skipped == true) and
    (.verification.nativeRebuilt == false) and
    (.verification.appPath | endswith("Enmanner Vite Example.app")) and
    (.verification.nativeTest.cyclesPassed == 2) and
    (.verification.doctor.valid == true)
  ' >/dev/null
"$example_dir/.enmanner/scripts/doctor" --json |
  jq -e '
    .doctor.localIntegrationComplete and
    .doctor.completionEvidence.developmentNativeLaunchVerified and
    .doctor.completionEvidence.nativeLaunchVerified and
    (.doctor.currentStatus.configuration == "valid") and
    (
      if .doctor.milestones.repositoryReady then
        .doctor.complete and
        (.doctor.currentStatus.integration == "complete")
      else
        (.doctor.complete == false) and
        (.doctor.currentStatus.integration == "repositoryRecordingRequired")
      end
    )
  ' >/dev/null
if find "$app_path" \( -name node_modules -o -name .git -o -name src -o -name enmanner.json \) |
  grep -q .; then
  echo "Error: generated app contains project source or dependencies." >&2
  exit 1
fi
if [[ -e "$example_dir/.enmanner/framework/Tests" ||
  -e "$example_dir/.enmanner/scripts/install" ]]; then
  echo "Error: installed example contains development-only framework files." >&2
  exit 1
fi

echo "✓ Vite smoke test passed and the app bundle contains only launcher assets"
